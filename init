#! /bin/bash

_PREPRINT_DIR_RAW="${BASH_SOURCE[0]%/*}"
[[ "$_PREPRINT_DIR_RAW" == "${BASH_SOURCE[0]}" ]] && _PREPRINT_DIR_RAW="."
_PREPRINT_DIR="$(cd "$_PREPRINT_DIR_RAW" && pwd)"

__preprint__() {
    __load script helper --from "$_PREPRINT_DIR/mods"
    __load script "*" --from "$_PREPRINT_DIR/mods/providers.d"

    __preprint__.__help__() {
        local dbs_csv
        dbs_csv="$(__preprint_providers_csv)"
        cat <<EOF >&2
ABOUT:
    omni academic preprint & publication manager

USAGE:
    preprint conf <ls|get|set|rm> [<provider>] [options]
    preprint ls <provider> [-s/--sort <time|alpha>] [-r/--reverse] [-n/--max <N>]
    preprint search <terms...> [-d/--database] <provider> [-D/--download] [-o/--output <path>] [-s/--sort <time|alpha>] [-r/--reverse] [-n/--max <page_size>] [--no-fzf]
    preprint get [<id>] -d/--database <provider> [-D/--download] [-o/--output <path>] [-s/--sort <time|alpha>] [-r/--reverse]
    preprint download [<id>] -d/--database <provider> [-o/--output <path>]
    preprint send [<file>] [metadata-options] -d/--database <provider>
    preprint publish [<id>] -d/--database <provider>
    preprint rm [<id>] -d/--database <provider>

REGISTERED PROVIDERS:
    ${dbs_csv}
$(__preprint_providers_help_table)

CONFIGURATION COMMANDS ('preprint conf'):
    conf ls                        List registered providers and status
    conf get <provider>            Inspect configuration & credentials for <provider>
    conf set <provider> [options]  Configure profile ID & credentials (interactive or via flags)
    conf rm <provider>             Remove stored configuration for <provider>

ENTRY & PUBLICATION COMMANDS:
    ls <provider> [options]        List publications & [DRAFT] entries in your profile
    send [<file>] -d <provider>    Stage a draft deposit or add a work entry to your profile
    publish [<id>] -d <provider>   Publish a [DRAFT] entry (omit <id> to pick interactively via fzf)
    rm [<id>] -d <provider>        Remove/delete a work or [DRAFT] entry from your profile
    get [<id>] -d <provider>       Inspect entry metadata (omit <id> to pick from profile via fzf)
    download [<id>] -d <provider>  Download entry PDF (alias: 'dl')

OPTIONS (for 'conf set'):
    -d, --database <prov>   Target provider (${dbs_csv})
    --profile <id>          Profile ID (Author ID, idHAL, ORCID iD, Scholar ID, S2 ID, OpenAlex ID, DBLP PID)
    --orcid <id>            ORCID iD (e.g., 0000-0002-1825-0097)
    --token <token>         API Token / OAuth Bearer token / API Key
    --user <user>           Account username/email
    --pass <pass>           Account password
    --sandbox               Use sandbox/preprod API endpoints
    --no-sandbox            Use production API endpoints (default)

METADATA OPTIONS (for 'send'):
    -d, --database <prov>   Target provider (${dbs_csv})
    -m, --meta <file>       Custom metadata file (YAML/Key-Value, JSON, or XML)
    -t, --title <title>     Title of the paper/work
    -a, --author <authors>  Authors separated by ';' (e.g., "John Doe; Jane Smith")
    -A, --abstract <text>   Abstract or short description
    -c, --category <cat>    Domain/Category (e.g., "math.NT", "cs.AI", "info.info-ai")
    --doi <doi>             DOI identifier (e.g., "10.1234/example.2026")
    --id <provider:id>      External identifier (repeatable, e.g., --id arxiv:2301.00001 --id hexagon:2610.00244v1)
    --url <url>             Work URL
    --journal <name>        Journal or host venue title
    --type <type>           Work type (default: "preprint"; e.g., "journal-article")
    --date <YYYY[-MM[-DD]]> Publication date (default: today)
EOF
    }

    preprint() {
        local cmd="${1:-}"
        if [[ -z "$cmd" || "$cmd" == "-h" || "$cmd" == "--help" ]]; then
            __preprint__.__help__
            return 0
        fi
        shift

        case "$cmd" in
            conf|config|database|db)
                __preprint_conf "$@"
                ;;
            ls|list)
                __preprint_list "$@"
                ;;
            get)
                __preprint_get "$@"
                ;;
            search)
                __preprint_search "$@"
                ;;
            download|dl)
                __preprint_get -D "$@"
                ;;
            send|push|add)
                __preprint_send "$@"
                ;;
            publish)
                __preprint_publish "$@"
                ;;
            rm|remove|del|delete)
                __preprint_rm "$@"
                ;;
            profile)
                # Legacy alias routing to conf or entry commands
                __preprint_profile_legacy "$@"
                ;;
            *)
                __log "Unknown command '$cmd'. Try 'preprint --help'." -t error -l preprint
                return 1
                ;;
        esac
    }

    __preprint__.__compl__() {
        local cur="${COMP_WORDS[COMP_CWORD]:-}"
        local prev="${COMP_WORDS[COMP_CWORD-1]:-}"
        local cmd="${COMP_WORDS[1]:-}"
        local subcmd="${COMP_WORDS[2]:-}"
        local dbs="${PREPRINT_PROVIDERS[*]}"
        local meta_flags="-d --database -m --meta -t --title -a --author -A --abstract -c --category --doi --id --url --journal --type --date"

        if [[ $COMP_CWORD -eq 1 ]]; then
            COMPREPLY=( $(compgen -W "conf ls search get download send publish rm --help -h" -- "$cur") )
            return 0
        fi

        if [[ "$prev" == "-d" || "$prev" == "--database" ]]; then
            COMPREPLY=( $(compgen -W "$dbs" -- "$cur") )
            return 0
        fi
        if [[ "$prev" == "-s" || "$prev" == "--sort" ]]; then
            COMPREPLY=( $(compgen -W "time alpha alphabetically" -- "$cur") )
            return 0
        fi
        if [[ "$prev" == "-m" || "$prev" == "--meta" || "$prev" == "-o" || "$prev" == "--output" ]]; then
            COMPREPLY=( $(compgen -f -- "$cur") )
            return 0
        fi

        case "$cmd" in
            conf|config)
                if [[ $COMP_CWORD -eq 2 ]]; then
                    COMPREPLY=( $(compgen -W "ls get set edit rm" -- "$cur") )
                elif [[ "$cur" == -* ]]; then
                    if [[ "$subcmd" == "set" || "$subcmd" == "edit" ]]; then
                        COMPREPLY=( $(compgen -W "-d --database --profile --orcid --token --user --pass --sandbox --no-sandbox" -- "$cur") )
                    elif [[ "$subcmd" == "rm" || "$subcmd" == "get" ]]; then
                        COMPREPLY=( $(compgen -W "-d --database" -- "$cur") )
                    fi
                elif [[ $COMP_CWORD -eq 3 && ( "$subcmd" == "set" || "$subcmd" == "edit" || "$subcmd" == "get" || "$subcmd" == "rm" ) ]]; then
                    COMPREPLY=( $(compgen -W "$dbs" -- "$cur") )
                fi
                ;;
            ls|list)
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "-d --database -s --sort -r --reverse -n --max" -- "$cur") )
                elif [[ $COMP_CWORD -eq 2 ]]; then
                    COMPREPLY=( $(compgen -W "$dbs" -- "$cur") )
                fi
                ;;
            get|download|dl)
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "-d --database -D --download -o --output -s --sort -r --reverse -n --max" -- "$cur") )
                fi
                ;;
            search)
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "-d --database -D --download -o --output -s --sort -r --reverse -n --max -l --no-fzf" -- "$cur") )
                elif [[ $COMP_CWORD -gt 2 ]]; then
                    COMPREPLY=( $(compgen -W "$dbs" -- "$cur") )
                fi
                ;;
            send|push|add)
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "$meta_flags" -- "$cur") )
                else
                    COMPREPLY=( $(compgen -f -- "$cur") )
                fi
                ;;
            publish|rm|remove|del|delete)
                if [[ "$cur" == -* ]]; then
                    COMPREPLY=( $(compgen -W "-d --database" -- "$cur") )
                elif [[ $COMP_CWORD -eq 2 ]]; then
                    COMPREPLY=( $(compgen -W "$dbs" -- "$cur") )
                fi
                ;;
        esac
    }

    __preprint__.__init__() {
        __compl preprint
    }
}
