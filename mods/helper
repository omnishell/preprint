#! /bin/bash

__helper__() {

    # =========================================================================
    # PROVIDER REGISTRY & CONTRACT ABSTRACTION
    # =========================================================================
    declare -ga PREPRINT_PROVIDERS=()
    declare -gA PREPRINT_PROVIDER_ALIASES=()
    declare -gA PREPRINT_PROVIDER_META=()

    # Register a preprint provider plugin:
    #   __preprint_register_provider <name> \
    #       [--aliases "a1,a2"] \
    #       [--pagination "offset|page"] \
    #       [--requires-file "true|false"] \
    #       [--desc "Description"]
    __preprint_register_provider() {
        local name="${1,,}"; shift || true
        [[ -z "$name" ]] && return 1

        local aliases="" pagination="offset" requires_file="true" desc=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --aliases)       aliases="$2"; shift 2 ;;
                --pagination)    pagination="$2"; shift 2 ;;
                --requires-file) requires_file="$2"; shift 2 ;;
                --desc)          desc="$2"; shift 2 ;;
                *) shift ;;
            esac
        done

        local existing found=0
        for existing in "${PREPRINT_PROVIDERS[@]}"; do
            [[ "$existing" == "$name" ]] && { found=1; break; }
        done
        (( found == 0 )) && PREPRINT_PROVIDERS+=("$name")

        PREPRINT_PROVIDER_ALIASES["$name"]="$name"
        if [[ -n "$aliases" ]]; then
            local IFS=',' a
            for a in $aliases; do
                a="${a,,}"
                a="${a#"${a%%[![:space:]]*}"}"
                a="${a%"${a##*[![:space:]]}"}"
                [[ -n "$a" ]] && PREPRINT_PROVIDER_ALIASES["$a"]="$name"
            done
        fi

        PREPRINT_PROVIDER_META["${name}:pagination"]="$pagination"
        PREPRINT_PROVIDER_META["${name}:requires_file"]="$requires_file"
        PREPRINT_PROVIDER_META["${name}:desc"]="$desc"
    }

    __preprint_norm_db() {
        local d="${1,,}"
        d="${d#"${d%%[![:space:]]*}"}"
        d="${d%"${d##*[![:space:]]}"}"
        if [[ -n "$d" && -n "${PREPRINT_PROVIDER_ALIASES[$d]:-}" ]]; then
            echo "${PREPRINT_PROVIDER_ALIASES[$d]}"
        else
            echo "$d"
        fi
    }

    __preprint_is_provider() {
        local db="$(__preprint_norm_db "$1")"
        [[ -n "$db" && -n "${PREPRINT_PROVIDER_ALIASES[$db]:-}" ]]
    }

    __preprint_providers_csv() {
        local OIFS="$IFS"
        IFS=', '
        echo "${PREPRINT_PROVIDERS[*]}"
        IFS="$OIFS"
    }

    __preprint_providers_help_table() {
        local p desc
        for p in "${PREPRINT_PROVIDERS[@]}"; do
            desc="${PREPRINT_PROVIDER_META["${p}:desc"]:-}"
            [[ -n "$desc" ]] && printf "    - %-10s %s\n" "$p" "$desc"
        done
    }

    __preprint_require_provider() {
        local db="$(__preprint_norm_db "$1")"
        if ! __preprint_is_provider "$db"; then
            __log "Unsupported provider '$1'. Registered providers: $(__preprint_providers_csv)." -t error -l preprint
            return 1
        fi
        return 0
    }

    # Invoke an internal provider method: __preprint_call <provider> <method> [args...]
    # Dispatches to: __preprint_provider_<provider>_<method>
    __preprint_call() {
        local db="$(__preprint_norm_db "$1")" method="$2"
        shift 2
        local fn="__preprint_provider_${db}_${method}"
        if ! declare -f "$fn" >/dev/null 2>&1; then
            __log "Provider '$db' does not implement '$method' ($fn)." -t error -l preprint
            return 1
        fi
        "$fn" "$@"
    }

    # =========================================================================
    # OMNIRC STATE & PURE BASH/AWK STRING HELPERS
    # =========================================================================
    __preprint_load_omnirc() {
        declare -gA PREPRINT_CONF 2>/dev/null || true
        local target="${OMNIRC:-$HOME/.omnirc}"
        [[ -f "$target" ]] && source "$target"
    }

    __preprint_save_omnirc() {
        local target="${OMNIRC:-$HOME/.omnirc}"
        local tmp="${target}.tmp"
        local in_block=0
        if [[ -f "$target" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                if [[ "$line" == "# --- PREPRINT AUTO START ---" ]]; then in_block=1; continue; fi
                if [[ "$line" == "# --- PREPRINT AUTO END ---" ]]; then in_block=0; continue; fi
                if (( in_block == 0 )); then printf "%s\n" "$line" >> "$tmp"; fi
            done < "$target"
        else
            touch "$tmp"
        fi

        {
            echo "# --- PREPRINT AUTO START ---"
            echo "declare -gA PREPRINT_CONF 2>/dev/null || true"
            for k in "${!PREPRINT_CONF[@]}"; do
                echo "PREPRINT_CONF[\"$k\"]=\"${PREPRINT_CONF[$k]}\""
            done
            echo "# --- PREPRINT AUTO END ---"
        } >> "$tmp"

        mv "$tmp" "$target"
    }

    __preprint_get_conf() {
        local db="$(__preprint_norm_db "$1")" key="$2"
        __preprint_load_omnirc
        local conf="${PREPRINT_CONF[$db]:-}"
        local -a pairs=()
        IFS=',' read -ra pairs <<< "$conf"
        local pair
        for pair in "${pairs[@]}"; do
            if [[ "${pair%%:*}" == "$key" ]]; then
                echo "${pair#*:}"
                return 0
            fi
        done
        return 1
    }

    # Pure Bash RFC 3986 URL encoder
    __preprint_urlencode() {
        local LC_ALL=C
        local str="$1" i c out="" hex
        for (( i=0; i<${#str}; i++ )); do
            c="${str:i:1}"
            case "$c" in
                [a-zA-Z0-9.~_-]) out+="$c" ;;
                *) printf -v hex '%%%02X' "'$c"; out+="$hex" ;;
            esac
        done
        printf '%s' "$out"
    }

    # Pure Bash JSON string escaper
    __preprint_json_escape() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\r'/}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        printf '%s' "$s"
    }

    # Pure Bash XML string escaper
    __preprint_xml_escape() {
        local s="$1"
        s="${s//&/&amp;}"
        s="${s//</&lt;}"
        s="${s//>/&gt;}"
        s="${s//\"/&quot;}"
        s="${s//\'/&apos;}"
        printf '%s' "$s"
    }

    # Normalize sort criteria ('time' or 'alpha')
    __preprint_norm_sort() {
        local s="${1,,}"
        case "$s" in
            alpha|alphabetical|alphabetically|title|name|a) echo "alpha" ;;
            time|date|t|"") echo "time" ;;
            *) echo "time" ;;
        esac
    }

    # Pure awk + sort pipeline for unified compact entry lines:
    # Format: [<id>] (<YYYY-MM-DD>) <Title>   <Authors>
    __preprint_sort_lines() {
        local sort_by="${1:-time}" rev="${2:-0}"
        sort_by="$(__preprint_norm_sort "$sort_by")"
        local sort_flags=("-t" $'\x1f' "-k1,1")
        if [[ "$sort_by" == "time" ]]; then
            if (( rev == 0 )); then
                sort_flags+=("-r")
            fi
        else
            if (( rev == 1 )); then
                sort_flags+=("-r")
            fi
        fi

        LC_ALL=C awk -v mode="$sort_by" '
            /^[ \t]*$/ { next }
            /^No / { print "~\x1f" $0; next }
            {
                line = $0
                rest = line
                id = ""
                if (match(rest, /^\[[^\]]+\][ \t]*/)) {
                    id = substr(rest, 2, RLENGTH - 2)
                    sub(/\][ \t]*$/, "", id)
                    rest = substr(rest, RLENGTH + 1)
                }
                paren = ""
                if (match(rest, /^\([^)]*\)[ \t]*/)) {
                    paren = substr(rest, 2, RLENGTH - 2)
                    sub(/\)[ \t]*$/, "", paren)
                    rest = substr(rest, RLENGTH + 1)
                }
                title = rest
                sub(/[ \t]*   .*$/, "", title)

                if (mode == "alpha") {
                    key = tolower(title)
                } else {
                    if (paren ~ /^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$/) {
                        key = paren
                    } else {
                        key = id
                    }
                }
                printf "%s\x1f%s\n", key, line
            }
        ' | LC_ALL=C sort "${sort_flags[@]}" | LC_ALL=C awk -F'\x1f' '{ print $2 }'
    }

    # =========================================================================
    # PDF DOWNLOAD HELPERS
    # =========================================================================
    __preprint_save_pdf_stream() {
        local pdf_url="$1" default_name="$2" out_path="${3:-}" fallback_url="${4:-}"
        [[ -z "$pdf_url" ]] && return 1

        local dest="$default_name"
        if [[ -n "$out_path" ]]; then
            if [[ -d "$out_path" ]]; then
                dest="${out_path%/}/$default_name"
            else
                dest="$out_path"
            fi
        fi

        __log "Downloading PDF from $pdf_url -> $dest ..." -t info -l preprint
        if curl -fL --progress-bar "$pdf_url" -o "$dest"; then
            __log "Saved PDF to '$dest'." -t success -l preprint
            return 0
        elif [[ -n "$fallback_url" ]] && curl -fL --progress-bar "$fallback_url" -o "$dest"; then
            __log "Saved PDF to '$dest'." -t success -l preprint
            return 0
        else
            rm -f "$dest" 2>/dev/null
            __log "Failed to download PDF from '$pdf_url'." -t error -l preprint
            return 1
        fi
    }

    __preprint_download_entry() {
        local db="$(__preprint_norm_db "$1")" id="$2" out_path="${3:-}"
        [[ -z "$db" || -z "$id" ]] && return 1
        __preprint_require_provider "$db" || return 1
        __preprint_call "$db" download "$id" "$out_path"
    }

    __preprint_prompt_download() {
        local db="$(__preprint_norm_db "$1")" id="$2" download_flag="${3:-0}" out_path="${4:-}"
        if (( download_flag == 1 )); then
            __preprint_download_entry "$db" "$id" "$out_path"
            return $?
        fi
        if [[ -t 0 && -t 1 ]]; then
            local ans=""
            echo ""
            read -r -p "Download PDF for '$id'? [y/N] " ans </dev/tty
            case "$ans" in
                [Yy]*) __preprint_download_entry "$db" "$id" "$out_path" ;;
            esac
        fi
    }

    # =========================================================================
    # DATABASE CONFIGURATION MANAGEMENT (preprint database ls/set/rm)
    # =========================================================================
    __preprint_database() {
        __preprint_load_omnirc
        local action="${1:-ls}"; shift || true

        case "$action" in
            ls|list)
                printf "%-12s %-14s %s\n" "PROVIDER" "STATUS" "CONFIGURED KEYS"
                printf "%-12s %-14s %s\n" "--------" "------" "---------------"
                local db pair k v
                for db in "${PREPRINT_PROVIDERS[@]}"; do
                    if [[ -n "${PREPRINT_CONF[$db]:-}" ]]; then
                        local -a keys=() pairs=()
                        IFS=',' read -ra pairs <<< "${PREPRINT_CONF[$db]}"
                        for pair in "${pairs[@]}"; do
                            k="${pair%%:*}"
                            v="${pair#*:}"
                            if [[ "$k" == "pass" || "$k" == "token" ]]; then
                                keys+=("${k}:*** (${#v} chars)")
                            elif [[ "$v" == *" "* ]]; then
                                keys+=("${k}:\"${v}\"")
                            else
                                keys+=("${k}:${v}")
                            fi
                        done
                        printf "%-12s %-14s %s\n" "$db" "registered" "${keys[*]}"
                    else
                        printf "%-12s %-14s %s\n" "$db" "unconfigured" "-"
                    fi
                done
                ;;
            set|new)
                local raw_db=""
                local -a rem_args=()
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -d|--database) raw_db="$2"; shift 2 ;;
                        --database=*)  raw_db="${1#*=}"; shift ;;
                        -*)            rem_args+=("$1"); shift ;;
                        *)
                            if [[ -z "$raw_db" ]]; then raw_db="$1"
                            else rem_args+=("$1"); fi
                            shift
                            ;;
                    esac
                done
                set -- "${rem_args[@]}"

                [[ -z "$raw_db" ]] && { __log "Usage: preprint database set -d <provider> [options]" -t error -l preprint; return 1; }
                local db="$(__preprint_norm_db "$raw_db")"
                __preprint_require_provider "$db" || return 1

                local token user pass orcid profile sandbox
                token="$(__preprint_get_conf "$db" token)"
                user="$(__preprint_get_conf "$db" user)"
                pass="$(__preprint_get_conf "$db" pass)"
                orcid="$(__preprint_get_conf "$db" orcid)"
                profile="$(__preprint_get_conf "$db" profile)"
                [[ -z "$profile" ]] && profile="$(__preprint_get_conf "$db" author)"
                sandbox="$(__preprint_get_conf "$db" sandbox)"
                [[ -z "$sandbox" ]] && sandbox="false"

                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --token)            token="$2"; shift 2 ;;
                        --user)             user="$2"; shift 2 ;;
                        --pass)             pass="$2"; shift 2 ;;
                        --orcid)            orcid="$2"; shift 2 ;;
                        --profile|--author) profile="$2"; shift 2 ;;
                        --sandbox)          sandbox="true"; shift ;;
                        --no-sandbox)       sandbox="false"; shift ;;
                        *) shift ;;
                    esac
                done

                local val="sandbox:$sandbox"
                [[ -n "$profile" ]] && val+=",profile:$profile"
                [[ -n "$orcid" ]]   && val+=",orcid:$orcid"
                [[ -n "$user" ]]    && val+=",user:$user"
                [[ -n "$pass" ]]    && val+=",pass:$pass"
                [[ -n "$token" ]]   && val+=",token:$token"

                PREPRINT_CONF["$db"]="$val"
                __preprint_save_omnirc
                __log "Provider '$db' configured." -t success -l preprint
                ;;
            rm|remove)
                local raw_db=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -d|--database) raw_db="$2"; shift 2 ;;
                        --database=*)  raw_db="${1#*=}"; shift ;;
                        *) [[ -z "$raw_db" ]] && raw_db="$1"; shift ;;
                    esac
                done
                [[ -z "$raw_db" ]] && { __log "Usage: preprint database rm -d <provider>" -t error -l preprint; return 1; }
                local db="$(__preprint_norm_db "$raw_db")"
                unset "PREPRINT_CONF[$db]"
                __preprint_save_omnirc
                __log "Provider '$db' removed." -t success -l preprint
                ;;
            *)
                __log "Unknown database command '$action'. Use: ls, set, or rm." -t error -l preprint
                return 1
                ;;
        esac
    }

    # =========================================================================
    # GENERIC COMMAND DISPATCHERS
    # =========================================================================
    __preprint_list() {
        local db="" max=0 sort_by="time" reverse=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                entries)       shift ;;
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -n|--max)      max="$2"; shift 2 ;;
                --max=*)       max="${1#*=}"; shift ;;
                -s|--sort)     sort_by="$2"; shift 2 ;;
                --sort=*)      sort_by="${1#*=}"; shift ;;
                -r|--reverse)  reverse=1; shift ;;
                -*) shift ;;
                *) [[ -z "$db" ]] && db="$(__preprint_norm_db "$1")"; shift ;;
            esac
        done

        if [[ -z "$db" ]]; then
            __log "Usage: preprint list -d/--database <provider> [-s/--sort <time|alpha>] [-r/--reverse]" -t error -l preprint
            return 1
        fi
        __preprint_require_provider "$db" || return 1

        sort_by="$(__preprint_norm_sort "$sort_by")"
        local raw_out=""
        raw_out="$(__preprint_call "$db" list "$max" "$sort_by" "$reverse")" || return 1

        if [[ -z "$raw_out" || "$raw_out" == "No "* ]]; then
            echo "${raw_out:-No entries found.}"
            return 0
        fi
        __preprint_sort_lines "$sort_by" "$reverse" <<< "$raw_out"
    }

    __preprint_get() {
        local target="" db="" max=0 sort_by="time" reverse=0 download=0 out_path="" used_fzf=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -D|--download) download=1; shift ;;
                -o|--output)   out_path="$2"; shift 2 ;;
                --output=*)    out_path="${1#*=}"; shift ;;
                -n|--max)      max="$2"; shift 2 ;;
                --max=*)       max="${1#*=}"; shift ;;
                -s|--sort)     sort_by="$2"; shift 2 ;;
                --sort=*)      sort_by="${1#*=}"; shift ;;
                -r|--reverse)  reverse=1; shift ;;
                -*) shift ;;
                *) [[ -z "$target" ]] && target="$1"; shift ;;
            esac
        done

        if [[ -z "$db" ]]; then
            __log "Usage: preprint get [<id>] -d/--database <provider> [-D/--download] [-o/--output <path>]" -t error -l preprint
            return 1
        fi
        __preprint_require_provider "$db" || return 1

        if [[ -z "$target" ]]; then
            if ! command -v fzf >/dev/null 2>&1; then
                __log "missing 'fzf' for interactive selection (pass <id> or install fzf)." -t error -l preprint
                return 1
            fi
            local entries fzf_out key selected rev_flag=()
            (( reverse == 1 )) && rev_flag=(-r)
            entries="$(__preprint_list -d "$db" -n "$max" -s "$sort_by" "${rev_flag[@]}")" || return 1
            if [[ -z "$entries" || "$entries" == "No "* ]]; then
                __log "No entries found in '$db' profile." -t info -l preprint
                return 1
            fi
            fzf_out=$(printf '%s\n' "$entries" | fzf --expect=ctrl-d --header="[ID] (Date) Title   Authors  |  Enter: details  |  Ctrl-D: download PDF" --prompt="Select $db entry > " --height=50% --layout=reverse --border)
            [[ -z "$fzf_out" ]] && return 0
            key="${fzf_out%%$'\n'*}"
            selected="${fzf_out#*$'\n'}"
            [[ "$key" == "$fzf_out" ]] && { key=""; selected="$fzf_out"; }
            [[ -z "$selected" ]] && return 0
            if [[ "$selected" =~ ^\[([^]]+)\] ]]; then
                target="${BASH_REMATCH[1]}"
            else
                target="${selected%% *}"
            fi
            if [[ "$key" == "ctrl-d" ]]; then
                __preprint_download_entry "$db" "$target" "$out_path"
                return $?
            fi
            used_fzf=1
        fi

        __preprint_call "$db" get "$target"

        if (( download == 1 || used_fzf == 1 )); then
            __preprint_prompt_download "$db" "$target" "$download" "$out_path"
        fi
    }

    __preprint_search() {
        local term="" db="" page_size=50 no_fzf=0 sort_by="time" reverse=0 download=0 out_path=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -D|--download) download=1; shift ;;
                -o|--output)   out_path="$2"; shift 2 ;;
                --output=*)    out_path="${1#*=}"; shift ;;
                -n|--max)      page_size="$2"; shift 2 ;;
                --max=*)       page_size="${1#*=}"; shift ;;
                -s|--sort)     sort_by="$2"; shift 2 ;;
                --sort=*)      sort_by="${1#*=}"; shift ;;
                -r|--reverse)  reverse=1; shift ;;
                -l|--no-fzf)   no_fzf=1; shift ;;
                -*) shift ;;
                *)
                    if [[ -z "$term" ]]; then term="$1"
                    else term="$term $1"; fi
                    shift
                    ;;
            esac
        done

        [[ -z "$term" || -z "$db" ]] && {
            __log "Usage: preprint search <term> -d/--database <provider> [-D/--download] [-s/--sort <time|alpha>] [-r/--reverse]" -t error -l preprint
            return 1
        }
        __preprint_require_provider "$db" || return 1

        (( page_size <= 0 )) && page_size=50
        sort_by="$(__preprint_norm_sort "$sort_by")"

        local pagination_mode="${PREPRINT_PROVIDER_META["${db}:pagination"]:-offset}"
        local page=1 cursor=0 results="" fzf_out="" key="" selected="" target="" count=0

        if (( no_fzf == 1 )) || [[ ! -t 1 ]] || ! command -v fzf >/dev/null 2>&1; then
            cursor=0
            [[ "$pagination_mode" == "page" ]] && cursor=1
            results="$(__preprint_call "$db" search "$term" "$page_size" "$cursor" "$sort_by" "$reverse")"
            if [[ -z "$results" || "$results" == "No "* ]]; then
                echo "${results:-No results found.}"
            else
                __preprint_sort_lines "$sort_by" "$reverse" <<< "$results"
            fi
            return 0
        fi

        while true; do
            if [[ "$pagination_mode" == "page" ]]; then
                cursor="$page"
            else
                cursor=$(( (page - 1) * page_size ))
            fi

            results="$(__preprint_call "$db" search "$term" "$page_size" "$cursor" "$sort_by" "$reverse")"

            if [[ -z "$results" || "$results" == "No "* ]]; then
                if (( page == 1 )); then
                    echo "${results:-No results found.}"
                    return 0
                else
                    __log "No more results beyond page $((page - 1))." -t info -l preprint
                    (( page-- ))
                    continue
                fi
            fi

            results="$(__preprint_sort_lines "$sort_by" "$reverse" <<< "$results")"
            count=$(printf '%s\n' "$results" | wc -l)
            local menu="$results"
            if (( page > 1 )); then
                menu=".."$'\n'"$menu"
            fi
            if (( count >= page_size )); then
                menu+=$'\n'"..."
            fi

            local order_label="newest"
            if [[ "$sort_by" == "time" && $reverse -eq 1 ]]; then order_label="oldest"
            elif [[ "$sort_by" == "alpha" && $reverse -eq 0 ]]; then order_label="A-Z"
            elif [[ "$sort_by" == "alpha" && $reverse -eq 1 ]]; then order_label="Z-A"; fi

            fzf_out=$(printf '%s\n' "$menu" | fzf --expect=ctrl-d --header="[ID] (Date) Title   Authors  |  Enter: details  |  Ctrl-D: download PDF" --prompt="Search $db [page $page | $order_label] > " --height=60% --layout=reverse --border)
            [[ -z "$fzf_out" ]] && return 0
            key="${fzf_out%%$'\n'*}"
            selected="${fzf_out#*$'\n'}"
            [[ "$key" == "$fzf_out" ]] && { key=""; selected="$fzf_out"; }
            [[ -z "$selected" ]] && return 0

            if [[ "$selected" == "..." ]]; then
                (( page++ ))
                continue
            elif [[ "$selected" == ".." ]]; then
                (( page > 1 )) && (( page-- ))
                continue
            fi
            break
        done

        if [[ "$selected" =~ ^\[([^]]+)\] ]]; then
            target="${BASH_REMATCH[1]}"
        else
            target="${selected%% *}"
        fi

        # Optional custom interactive selection hook (e.g., ORCID researcher -> works drilldown)
        if declare -f "__preprint_provider_${db}_on_select" >/dev/null 2>&1; then
            "__preprint_provider_${db}_on_select" "$target" "$selected" "$key" "$sort_by" "$reverse" "$download" "$out_path"
            return $?
        fi

        if [[ "$key" == "ctrl-d" ]]; then
            __preprint_download_entry "$db" "$target" "$out_path"
            return $?
        fi

        __preprint_call "$db" get "$target"
        __preprint_prompt_download "$db" "$target" "$download" "$out_path"
    }

    __preprint_send() {
        local PREPRINT_SEND_FILE="" db="" PREPRINT_SEND_META="" PREPRINT_SEND_TITLE=""
        local PREPRINT_SEND_AUTHOR="" PREPRINT_SEND_ABSTRACT="" PREPRINT_SEND_CATEGORY=""
        local PREPRINT_SEND_DOI="" PREPRINT_SEND_URL="" PREPRINT_SEND_JOURNAL=""
        local PREPRINT_SEND_TYPE="preprint" PREPRINT_SEND_DATE="" PREPRINT_SEND_PUBLISH=0
        declare -A PREPRINT_SEND_EXT_IDS=()

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -m|--meta)     PREPRINT_SEND_META="$2"; shift 2 ;;
                -t|--title)    PREPRINT_SEND_TITLE="$2"; shift 2 ;;
                -a|--author)   PREPRINT_SEND_AUTHOR="$2"; shift 2 ;;
                -A|--abstract) PREPRINT_SEND_ABSTRACT="$2"; shift 2 ;;
                -c|--category) PREPRINT_SEND_CATEGORY="$2"; shift 2 ;;
                --doi)         PREPRINT_SEND_DOI="$2"; PREPRINT_SEND_EXT_IDS["doi"]="$2"; shift 2 ;;
                --url)         PREPRINT_SEND_URL="$2"; shift 2 ;;
                --journal)     PREPRINT_SEND_JOURNAL="$2"; shift 2 ;;
                --type)        PREPRINT_SEND_TYPE="$2"; shift 2 ;;
                --date)        PREPRINT_SEND_DATE="$2"; shift 2 ;;
                --publish)     PREPRINT_SEND_PUBLISH=1; shift ;;
                --id)
                    if [[ "$2" == *:* ]]; then
                        local k="$(__preprint_norm_db "${2%%:*}")"
                        PREPRINT_SEND_EXT_IDS["$k"]="${2#*:}"
                    fi
                    shift 2
                    ;;
                --*)
                    local flag_name="${1#--}"
                    local norm_flag="$(__preprint_norm_db "$flag_name")"
                    if __preprint_is_provider "$norm_flag" && [[ $# -ge 2 ]]; then
                        PREPRINT_SEND_EXT_IDS["$norm_flag"]="$2"
                        shift 2
                    else
                        shift
                    fi
                    ;;
                -*) shift ;;
                *) [[ -z "$PREPRINT_SEND_FILE" ]] && PREPRINT_SEND_FILE="$1"; shift ;;
            esac
        done

        [[ -z "$db" ]] && {
            __log "Target provider required (-d/--database <$(__preprint_providers_csv)>)." -t error -l preprint
            return 1
        }
        __preprint_require_provider "$db" || return 1

        local req_file="${PREPRINT_PROVIDER_META["${db}:requires_file"]:-true}"
        if [[ "$req_file" == "true" && -z "$PREPRINT_SEND_FILE" ]]; then
            __log "Usage: preprint send <file> -d/--database $db [options]" -t error -l preprint
            return 1
        fi
        if [[ -n "$PREPRINT_SEND_FILE" && ! -e "$PREPRINT_SEND_FILE" ]]; then
            __log "File or directory not found: '$PREPRINT_SEND_FILE'" -t error -l preprint
            return 1
        fi

        __preprint_call "$db" send
    }
}
