#! /bin/bash

__helper__() {

    # =========================================================================
    # PROVIDER REGISTRY & CONTRACT ABSTRACTION
    # =========================================================================
    declare -ga PREPRINT_PROVIDERS=()
    declare -gA PREPRINT_PROVIDER_ALIASES=()
    declare -gA PREPRINT_PROVIDER_META=()

    __preprint_register_provider() {
        local name="${1,,}"; shift || true
        [[ -z "$name" ]] && return 1

        local aliases="" pagination="offset" requires_file="true" requires_category="false" desc=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --aliases)           aliases="$2"; shift 2 ;;
                --pagination)        pagination="$2"; shift 2 ;;
                --requires-file)     requires_file="$2"; shift 2 ;;
                --requires-category) requires_category="$2"; shift 2 ;;
                --desc)              desc="$2"; shift 2 ;;
                *) shift ;;
            esac
        done

        local existing found=0
        for existing in "${PREPRINT_PROVIDERS[@]}"; do
            [[ "$existing" == "$name" ]] && { found=1; break; }
        done
        (( found == 0 )) && PREPRINT_PROVIDERS+=("$name")

        PREPRINT_PROVIDER_ALIASES["$name"]="$name"
        if [[ -n "$aliases" ]]; then
            local IFS=',' a
            for a in $aliases; do
                a="${a,,}"
                a="${a#"${a%%[![:space:]]*}"}"
                a="${a%"${a##*[![:space:]]}"}"
                [[ -n "$a" ]] && PREPRINT_PROVIDER_ALIASES["$a"]="$name"
            done
        fi

        PREPRINT_PROVIDER_META["${name}:pagination"]="$pagination"
        PREPRINT_PROVIDER_META["${name}:requires_file"]="$requires_file"
        PREPRINT_PROVIDER_META["${name}:requires_category"]="$requires_category"
        PREPRINT_PROVIDER_META["${name}:desc"]="$desc"
    }

    __preprint_norm_db() {
        local d="${1,,}"
        d="${d#"${d%%[![:space:]]*}"}"
        d="${d%"${d##*[![:space:]]}"}"
        if [[ -n "$d" && -n "${PREPRINT_PROVIDER_ALIASES[$d]:-}" ]]; then
            echo "${PREPRINT_PROVIDER_ALIASES[$d]}"
        else
            echo "$d"
        fi
    }

    __preprint_is_provider() {
        local db="$(__preprint_norm_db "$1")"
        [[ -n "$db" && -n "${PREPRINT_PROVIDER_ALIASES[$db]:-}" ]]
    }

    __preprint_providers_csv() {
        local OIFS="$IFS"
        IFS=', '
        echo "${PREPRINT_PROVIDERS[*]}"
        IFS="$OIFS"
    }

    __preprint_providers_help_table() {
        local p desc
        for p in "${PREPRINT_PROVIDERS[@]}"; do
            desc="${PREPRINT_PROVIDER_META["${p}:desc"]:-}"
            [[ -n "$desc" ]] && printf "    - %-12s %s\n" "$p" "$desc"
        done
    }

    __preprint_require_provider() {
        local db="$(__preprint_norm_db "$1")"
        if ! __preprint_is_provider "$db"; then
            __log "Unsupported provider '$1'. Registered providers: $(__preprint_providers_csv)." -t error -l preprint
            return 1
        fi
        return 0
    }

    __preprint_call() {
        local db="$(__preprint_norm_db "$1")" method="$2"
        shift 2
        local fn="__preprint_provider_${db}_${method}"
        if ! declare -f "$fn" >/dev/null 2>&1; then
            __log "Provider '$db' does not implement '$method' ($fn)." -t error -l preprint
            return 1
        fi
        "$fn" "$@"
    }

    # =========================================================================
    # DRAFT STORE MANAGEMENT (tracks unpublished drafts across providers)
    # =========================================================================
    __preprint_draft_store_file() {
        local dir="${XDG_DATA_HOME:-$HOME/.local/share}/omni/preprint"
        mkdir -p "$dir"
        echo "$dir/drafts.tsv"
    }

    __preprint_draft_save() {
        local db="$(__preprint_norm_db "$1")" id="$2" date="${3:-N/A}" title="${4:-Untitled}"
        local authors="${5:-Anonymous}" pkg_path="${6:--}" extra="${7:--}"
        [[ -z "$db" || -z "$id" ]] && return 1

        local store="$(__preprint_draft_store_file)"
        local tmp="${store}.tmp"
        title="${title//$'\t'/ }"; title="${title//$'\n'/ }"
        authors="${authors//$'\t'/ }"; authors="${authors//$'\n'/ }"

        if [[ -f "$store" ]]; then
            LC_ALL=C awk -F'\t' -v db="$db" -v id="$id" '
                !($1 == db && $2 == id) { print $0 }
            ' "$store" > "$tmp"
        else
            : > "$tmp"
        fi
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$db" "$id" "$date" "$title" "$authors" "$pkg_path" "$extra" >> "$tmp"
        mv "$tmp" "$store"
    }

    __preprint_draft_rm() {
        local db="$(__preprint_norm_db "$1")" id="$2"
        local store="$(__preprint_draft_store_file)"
        [[ ! -f "$store" ]] && return 0
        local tmp="${store}.tmp"
        local pkg_path=""
        pkg_path=$(LC_ALL=C awk -F'\t' -v db="$db" -v id="$id" '$1 == db && $2 == id { print $6; exit }' "$store")
        # SAFETY GUARD: Only delete cached archives inside our internal hal_drafts directory, NEVER user files!
        local safe_cache_dir="${XDG_DATA_HOME:-$HOME/.local/share}/omni/preprint/hal_drafts/"
        if [[ -n "$pkg_path" && "$pkg_path" == "${safe_cache_dir}"* && -e "$pkg_path" ]]; then
            rm -rf "$pkg_path" 2>/dev/null
        fi
        LC_ALL=C awk -F'\t' -v db="$db" -v id="$id" '!($1 == db && $2 == id) { print $0 }' "$store" > "$tmp"
        mv "$tmp" "$store"
    }

    __preprint_draft_get() {
        local db="$(__preprint_norm_db "$1")" id="$2"
        local store="$(__preprint_draft_store_file)"
        [[ ! -f "$store" ]] && return 1
        LC_ALL=C awk -F'\t' -v db="$db" -v id="$id" '
            $1 == db && $2 == id { print $0; found = 1; exit }
            END { if (!found) exit 1 }
        ' "$store"
    }

    __preprint_draft_list_Formatted() {
        local db="$(__preprint_norm_db "$1")"
        local store="$(__preprint_draft_store_file)"
        [[ ! -f "$store" ]] && return 0
        LC_ALL=C awk -F'\t' -v db="$db" '
            $1 == db && NF >= 5 {
                printf "[%s] (%s) [DRAFT] %s   %s\n", $2, $3, $4, $5
            }
        ' "$store"
    }

    __preprint_merge_profile_drafts() {
        local db="$(__preprint_norm_db "$1")" remote_out="$2"
        local local_drafts
        local_drafts="$(__preprint_draft_list_Formatted "$db")"
        if [[ -z "$local_drafts" ]]; then
            echo "$remote_out"
            return 0
        fi
        if [[ -z "$remote_out" || "$remote_out" == "No "* ]]; then
            echo "$local_drafts"
            return 0
        fi

        LC_ALL=C awk '
            FNR == NR {
                if (match($0, /^\[[^\]]+\]/)) {
                    id = substr($0, 2, RLENGTH - 2)
                    sub(/^hexagon:/, "", id)
                    draft_line[id] = $0
                    draft_order[++dcount] = id
                }
                next
            }
            /^No / { next }
            {
                if (match($0, /^\[[^\]]+\]/)) {
                    id = substr($0, 2, RLENGTH - 2)
                    clean_id = id; sub(/^hexagon:/, "", clean_id)
                    seen_remote[clean_id] = 1
                    if ((clean_id in draft_line) && $0 !~ /\[DRAFT\]/) {
                        line = $0
                        if (match(line, /^\[[^\]]+\][ \t]*\([^)]*\)[ \t]*/)) {
                            prefix = substr(line, 1, RLENGTH)
                            rest = substr(line, RLENGTH + 1)
                            print prefix "[DRAFT] " rest
                            next
                        }
                    }
                }
                print $0
            }
            END {
                for (i = 1; i <= dcount; i++) {
                    id = draft_order[i]
                    if (!(id in seen_remote)) {
                        print draft_line[id]
                    }
                }
            }
        ' <(printf '%s\n' "$local_drafts") <(printf '%s\n' "$remote_out")
    }

    # =========================================================================
    # OMNIRC STATE, KV/TEX META PARSERS & PURE BASH/AWK STRING HELPERS
    # =========================================================================
    __preprint_load_omnirc() {
        declare -gA PREPRINT_CONF 2>/dev/null || true
        local target="${OMNIRC:-$HOME/.omnirc}"
        [[ -f "$target" ]] && source "$target"
    }

    __preprint_save_omnirc() {
        local target="${OMNIRC:-$HOME/.omnirc}"
        local tmp="${target}.tmp"
        local in_block=0

        if [[ -f "$target" ]]; then
            while IFS= read -r line || [[ -n "$line" ]]; do
                if [[ "$line" == "# --- PREPRINT AUTO START ---" ]]; then in_block=1; continue; fi
                if [[ "$line" == "# --- PREPRINT AUTO END ---" ]]; then in_block=0; continue; fi
                if (( in_block == 0 )); then printf "%s\n" "$line" >> "$tmp"; fi
            done < "$target"
        else
            touch "$tmp"
        fi

        {
            echo "# --- PREPRINT AUTO START ---"
            echo "declare -gA PREPRINT_CONF 2>/dev/null || true"
            for k in "${!PREPRINT_CONF[@]}"; do
                echo "PREPRINT_CONF[\"$k\"]=\"${PREPRINT_CONF[$k]}\""
            done
            echo "# --- PREPRINT AUTO END ---"
        } >> "$tmp"

        mv "$tmp" "$target"
    }

    __preprint_get_conf() {
        local db="$(__preprint_norm_db "$1")" key="$2"
        __preprint_load_omnirc
        local conf="${PREPRINT_CONF[$db]:-}"
        local -a pairs=()
        IFS=',' read -ra pairs <<< "$conf"
        local pair
        for pair in "${pairs[@]}"; do
            if [[ "${pair%%:*}" == "$key" ]]; then
                echo "${pair#*:}"
                return 0
            fi
        done
        return 1
    }

    __preprint_is_profile_registered() {
        local db="$(__preprint_norm_db "$1")"
        __preprint_load_omnirc

        local conf="${PREPRINT_CONF[$db]:-}"
        if [[ -n "$conf" ]]; then
            local -a pairs=()
            IFS=',' read -ra pairs <<< "$conf"
            local pair k v
            for pair in "${pairs[@]}"; do
                k="${pair%%:*}"
                v="${pair#*:}"
                if [[ "$k" != "sandbox" && -n "$v" ]]; then
                    return 0
                fi
            done
        fi

        local up="${db^^}"
        local env_p="${up}_PROFILE" env_o="${up}_ORCID" env_t="${up}_TOKEN" env_u="${up}_USER"
        if [[ -n "${!env_p:-}" || -n "${!env_o:-}" || -n "${!env_t:-}" || -n "${!env_u:-}" ]]; then
            return 0
        fi
        [[ "$db" == "orcid" && -n "${ORCID_ID:-}" ]] && return 0

        return 1
    }

    __preprint_require_registered_profile() {
        local db="$(__preprint_norm_db "$1")"
        __preprint_require_provider "$db" || return 1
        if ! __preprint_is_profile_registered "$db"; then
            __log "profile not registered" -t error -l preprint
            return 1
        fi
        return 0
    }

    __preprint_load_kv_meta() {
        local mfile="$1"
        [[ -z "$mfile" || ! -f "$mfile" ]] && return 0
        local first_char
        first_char=$(LC_ALL=C awk '/[^ \t\r\n]/ { print substr($0, match($0, /[^ \t\r\n]/), 1); exit }' "$mfile")
        [[ "$first_char" == "{" || "$first_char" == "[" || "$first_char" == "<" ]] && return 0

        local line k v
        while IFS= read -r line || [[ -n "$line" ]]; do
            [[ "$line" =~ ^[[:space:]]*# || -z "${line//[[:space:]]/}" ]] && continue
            if [[ "$line" =~ ^[[:space:]]*([a-zA-Z0-9_-]+)[[:space:]]*:[[:space:]]*(.*)$ ]]; then
                k="${BASH_REMATCH[1],,}"
                v="${BASH_REMATCH[2]}"
                v="${v#"${v%%[![:space:]]*}"}"
                v="${v%"${v##*[![:space:]]}"}"
                v="${v#\"}"; v="${v%\"}"
                v="${v#\'}"; v="${v%\'}"
                case "$k" in
                    title)                        [[ -z "$PREPRINT_SEND_TITLE" ]] && PREPRINT_SEND_TITLE="$v" ;;
                    author|authors|creators)      [[ -z "$PREPRINT_SEND_AUTHOR" ]] && PREPRINT_SEND_AUTHOR="$v" ;;
                    affiliation|affiliations|address) [[ -z "${PREPRINT_SEND_AFFILIATIONS:-}" ]] && PREPRINT_SEND_AFFILIATIONS="$v" ;;
                    email|emails)                 [[ -z "${PREPRINT_SEND_EMAILS:-}" ]] && PREPRINT_SEND_EMAILS="$v" ;;
                    abstract|summary|description) [[ -z "$PREPRINT_SEND_ABSTRACT" ]] && PREPRINT_SEND_ABSTRACT="$v" ;;
                    category|domain|subject)      [[ -z "$PREPRINT_SEND_CATEGORY" ]] && PREPRINT_SEND_CATEGORY="$v" ;;
                    msc|subjclass|msccodes)       [[ -z "${PREPRINT_SEND_MSC:-}" ]] && PREPRINT_SEND_MSC="$v" ;;
                    keywords|tags)                [[ -z "${PREPRINT_SEND_KEYWORDS:-}" ]] && PREPRINT_SEND_KEYWORDS="$v" ;;
                    doi)                          [[ -z "$PREPRINT_SEND_DOI" ]] && { PREPRINT_SEND_DOI="$v"; PREPRINT_SEND_EXT_IDS["doi"]="$v"; } ;;
                    arxiv)                        PREPRINT_SEND_EXT_IDS["arxiv"]="$v" ;;
                    hal)                          PREPRINT_SEND_EXT_IDS["hal"]="$v" ;;
                    hexagon)                      PREPRINT_SEND_EXT_IDS["hexagon"]="$v" ;;
                    url)                          [[ -z "$PREPRINT_SEND_URL" ]] && PREPRINT_SEND_URL="$v" ;;
                    journal|venue)                [[ -z "$PREPRINT_SEND_JOURNAL" ]] && PREPRINT_SEND_JOURNAL="$v" ;;
                    type)                         PREPRINT_SEND_TYPE="$v" ;;
                    date|published)               [[ -z "$PREPRINT_SEND_DATE" ]] && PREPRINT_SEND_DATE="$v" ;;
                esac
            fi
        done < "$mfile"
    }

    # Global balanced-brace LaTeX metadata extractor for \title, \author, \address/\affiliation, \email, \begin{abstract}, \subjclass, and \keywords
    __preprint_extract_tex_meta() {
        local tex_file="$1" field="$2"
        [[ -z "$tex_file" || ! -f "$tex_file" ]] && return 1
        LC_ALL=C awk -v field="$field" '
            function clean_tex(s) {
                gsub(/%[^\n]*\n/, " ", s)
                while (sub(/\\(thanks|footnote|inst|affiliation|address|email|orcidlink)\{([^{}]|\{[^{}]*\})*\}/, "", s)) {}
                gsub(/\$[\^_][^\$]+\$/, "", s)
                gsub(/\\and([ \t\r\n]+|\\)/, "; ", s)
                gsub(/\\\\/, " ", s)
                gsub(/\\(textbf|textit|emph|textrm|textsc|texttt|mathbf|mathrm)\{/, "{", s)
                gsub(/[{}]/, "", s)
                gsub(/^[ \t\r\n;]+|[ \t\r\n;]+$/, "", s)
                gsub(/[ \t\r\n]+/, " ", s)
                return s
            }
            function clean_affil(s) {
                gsub(/%[^\n]*\n/, " ", s)
                gsub(/\\\\/, ", ", s)
                gsub(/\\(textbf|textit|emph|textrm|textsc|texttt)\{/, "{", s)
                gsub(/[{}]/, "", s)
                gsub(/^[ \t\r\n,;]+|[ \t\r\n,;]+$/, "", s)
                gsub(/[ \t\r\n]+/, " ", s)
                return s
            }
            function clean_keywords(s) {
                gsub(/%[^\n]*\n/, " ", s)
                gsub(/\\\\/, " ", s)
                gsub(/\\(textbf|textit|emph|textrm|textsc)\{/, "{", s)
                gsub(/^[ \t\r\n;.]+|[ \t\r\n;.]+$/, "", s)
                gsub(/[ \t\r\n]+/, " ", s)
                return s
            }
            function extract_cmd(src, cmd,    s, depth, i, c, out, all) {
                s = src
                all = ""
                while (match(s, "\\\\" cmd "(\\[[^\\]]*\\])?[ \t\r\n]*\\{")) {
                    s = substr(s, RSTART + RLENGTH)
                    depth = 1
                    out = ""
                    for (i = 1; i <= length(s); i++) {
                        c = substr(s, i, 1)
                        if (c == "{") depth++
                        else if (c == "}") {
                            depth--
                            if (depth == 0) break
                        }
                        out = out c
                    }
                    s = substr(s, i + 1)
                    if (cmd == "keywords") {
                        out = clean_keywords(out)
                        if (out != "") return out
                    } else if (cmd == "address" || cmd == "affiliation" || cmd == "email") {
                        out = clean_affil(out)
                        if (out != "") all = (all == "" ? out : all "; " out)
                    } else {
                        out = clean_tex(out)
                        if (out != "") {
                            if (cmd == "author") all = (all == "" ? out : all "; " out)
                            else return out
                        }
                    }
                }
                return all
            }
            {
                sub(/([^\\]|^)%.*$/, "\\1")
                raw = raw $0 "\n"
            }
            END {
                if (field == "title") {
                    print extract_cmd(raw, "title")
                } else if (field == "author") {
                    print extract_cmd(raw, "author")
                } else if (field == "affiliation") {
                    res = extract_cmd(raw, "address")
                    if (res == "") res = extract_cmd(raw, "affiliation")
                    print res
                } else if (field == "email") {
                    print extract_cmd(raw, "email")
                } else if (field == "abstract") {
                    b_idx = index(raw, "\\begin{abstract}")
                    e_idx = index(raw, "\\end{abstract}")
                    if (b_idx > 0 && e_idx > b_idx) {
                        s = substr(raw, b_idx + 16, e_idx - (b_idx + 16))
                        gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s)
                        gsub(/[ \t\r\n]+/, " ", s)
                        print s
                    } else {
                        print extract_cmd(raw, "abstract")
                    }
                } else if (field == "msc") {
                    s = extract_cmd(raw, "subjclass")
                    if (s == "" && match(raw, /MSC[^:}]*:\}?[ \t]*[0-9A-Z; ,-]+/)) {
                        s = substr(raw, RSTART, RLENGTH)
                        sub(/^.*:\}?[ \t]*/, "", s)
                    }
                    out = ""; count = 0
                    while (match(s, /[0-9]{2}([A-Z][0-9]{2}|-[0-9]{2})/)) {
                        code = substr(s, RSTART, RLENGTH)
                        s = substr(s, RSTART + RLENGTH)
                        if (!(code in seen)) {
                            seen[code] = 1
                            out = (out == "" ? code : out ", " code)
                            if (++count >= 5) break
                        }
                    }
                    print out
                } else if (field == "keywords") {
                    s = extract_cmd(raw, "keywords")
                    if (s != "") {
                        sep = (index(s, ";") > 0 ? ";" : ",")
                        n = split(s, kw_arr, sep)
                        out = ""; count = 0
                        for (i = 1; i <= n; i++) {
                            k = kw_arr[i]
                            gsub(/^[ \t\r\n.]+|[ \t\r\n.]+$/, "", k)
                            if (k != "" && !(tolower(k) in seen_kw)) {
                                seen_kw[tolower(k)] = 1
                                k = substr(k, 1, 80)
                                out = (out == "" ? k : out "; " k)
                                if (++count >= 12) break
                            }
                        }
                        print out
                    }
                }
            }
        ' "$tex_file"
    }

    __preprint_is_raw_payload_meta() {
        local mfile="$1"
        [[ -z "$mfile" || ! -f "$mfile" ]] && return 1
        local first_char
        first_char=$(LC_ALL=C awk '/[^ \t\r\n]/ { print substr($0, match($0, /[^ \t\r\n]/), 1); exit }' "$mfile")
        [[ "$first_char" == "{" || "$first_char" == "[" || "$first_char" == "<" ]]
    }

    __preprint_urlencode() {
        local LC_ALL=C
        local str="$1" i c out="" hex
        for (( i=0; i<${#str}; i++ )); do
            c="${str:i:1}"
            case "$c" in
                [a-zA-Z0-9.~_-]) out+="$c" ;;
                *) printf -v hex '%%%02X' "'$c"; out+="$hex" ;;
            esac
        done
        printf '%s' "$out"
    }

    __preprint_json_escape() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\r'/}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\t'/\\t}"
        printf '%s' "$s"
    }

    __preprint_xml_escape() {
        local s="$1"
        s="${s//&/&amp;}"
        s="${s//</&lt;}"
        s="${s//>/&gt;}"
        s="${s//\"/&quot;}"
        s="${s//\'/&apos;}"
        printf '%s' "$s"
    }

    __preprint_norm_sort() {
        local s="${1,,}"
        case "$s" in
            alpha|alphabetical|alphabetically|title|name|a) echo "alpha" ;;
            time|date|t|"") echo "time" ;;
            *) echo "time" ;;
        esac
    }

    __preprint_sort_lines() {
        local sort_by="${1:-time}" rev="${2:-0}"
        sort_by="$(__preprint_norm_sort "$sort_by")"
        local sort_flags=("-t" $'\x1f' "-k1,1")
        if [[ "$sort_by" == "time" ]]; then
            if (( rev == 0 )); then
                sort_flags+=("-r")
            fi
        else
            if (( rev == 1 )); then
                sort_flags+=("-r")
            fi
        fi

        LC_ALL=C awk -v mode="$sort_by" '
            /^[ \t]*$/ { next }
            /^No / { print "~\x1f" $0; next }
            {
                line = $0
                rest = line
                id = ""
                if (match(rest, /^\[[^\]]+\][ \t]*/)) {
                    id = substr(rest, 2, RLENGTH - 2)
                    sub(/\][ \t]*$/, "", id)
                    rest = substr(rest, RLENGTH + 1)
                }
                paren = ""
                if (match(rest, /^\([^)]*\)[ \t]*/)) {
                    paren = substr(rest, 2, RLENGTH - 2)
                    sub(/\)[ \t]*$/, "", paren)
                    rest = substr(rest, RLENGTH + 1)
                }
                sub(/^\[DRAFT\][ \t]*/, "", rest)
                title = rest
                sub(/[ \t]*   .*$/, "", title)

                if (mode == "alpha") {
                    key = tolower(title)
                } else {
                    if (paren ~ /^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$/) {
                        key = paren
                    } else {
                        key = id
                    }
                }
                printf "%s\x1f%s\n", key, line
            }
        ' | LC_ALL=C sort "${sort_flags[@]}" | LC_ALL=C awk -F'\x1f' '{ print $2 }'
    }

    # =========================================================================
    # PDF DOWNLOAD HELPERS
    # =========================================================================
    __preprint_save_pdf_stream() {
        local pdf_url="$1" default_name="$2" out_path="${3:-}" fallback_url="${4:-}"
        [[ -z "$pdf_url" || "$pdf_url" == "-" || "$pdf_url" == "N/A" ]] && return 1

        local dest="$default_name"
        if [[ -n "$out_path" ]]; then
            if [[ -d "$out_path" ]]; then
                dest="${out_path%/}/$default_name"
            else
                dest="$out_path"
            fi
        fi

        if [[ "$pdf_url" =~ ^https?://arxiv\.org/abs/(.+)$ ]]; then
            pdf_url="https://arxiv.org/pdf/${BASH_REMATCH[1]}.pdf"
        fi

        __log "Downloading PDF from $pdf_url -> $dest ..." -t info -l preprint
        local ua="Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0"
        if curl -fL -A "$ua" -H "Accept: application/pdf,*/*" --progress-bar "$pdf_url" -o "$dest" && [[ -s "$dest" ]] && head -c 1024 "$dest" | grep -q "%PDF-"; then
            __log "Saved PDF to '$dest'." -t success -l preprint
            return 0
        elif [[ -n "$fallback_url" && "$fallback_url" != "-" ]] && curl -fL -A "$ua" -H "Accept: application/pdf,*/*" --progress-bar "$fallback_url" -o "$dest" && [[ -s "$dest" ]] && head -c 1024 "$dest" | grep -q "%PDF-"; then
            __log "Saved PDF to '$dest'." -t success -l preprint
            return 0
        else
            rm -f "$dest" 2>/dev/null
            __log "Failed to download a valid PDF from '$pdf_url'." -t error -l preprint
            return 1
        fi
    }

    __preprint_resolve_doi_pdf() {
        local doi="${1#https://doi.org/}" out_path="${2:-}" default_name="${3:-paper.pdf}"
        [[ -z "$doi" || "$doi" == "-" || "$doi" == "N/A" ]] && return 1
        if [[ "$doi" =~ 10\.48550/arXiv\.(.+)$ ]]; then
            __preprint_download_entry "arxiv" "${BASH_REMATCH[1]}" "$out_path"
            return $?
        fi
        local oa_json pdf_url oa_url
        oa_json=$(curl -fsSL "https://api.openalex.org/works/https://doi.org/$(__preprint_urlencode "$doi")" 2>/dev/null)
        IFS=$'\t' read -r pdf_url oa_url < <(LC_ALL=C awk '
            { raw = raw $0 "\n" }
            END {
                p = "-"; o = "-"
                if (match(raw, /"pdf_url"[ \t]*:[ \t]*"https?:\/\/[^"]+"/)) {
                    s = substr(raw, RSTART, RLENGTH)
                    sub(/^"pdf_url"[ \t]*:[ \t]*"/, "", s); sub(/"$/, "", s); p = s
                }
                if (match(raw, /"oa_url"[ \t]*:[ \t]*"https?:\/\/[^"]+"/)) {
                    s = substr(raw, RSTART, RLENGTH)
                    sub(/^"oa_url"[ \t]*:[ \t]*"/, "", s); sub(/"$/, "", s); o = s
                }
                printf "%s\t%s\n", p, o
            }
        ' <<< "$oa_json")

        if [[ -n "$pdf_url" && "$pdf_url" != "-" ]]; then
            __preprint_save_pdf_stream "$pdf_url" "$default_name" "$out_path" "${oa_url}" && return 0
        fi
        if [[ -n "$oa_url" && "$oa_url" != "-" ]]; then
            __preprint_save_pdf_stream "$oa_url" "$default_name" "$out_path" && return 0
        fi
        return 1
    }

    __preprint_download_entry() {
        local db="$(__preprint_norm_db "$1")" id="$2" out_path="${3:-}"
        [[ -z "$db" || -z "$id" ]] && return 1
        __preprint_require_provider "$db" || return 1
        __preprint_call "$db" download "$id" "$out_path"
    }

    __preprint_prompt_download() {
        local db="$(__preprint_norm_db "$1")" id="$2" download_flag="${3:-0}" out_path="${4:-}"
        if (( download_flag == 1 )); then
            __preprint_download_entry "$db" "$id" "$out_path"
            return $?
        fi
        if [[ -t 0 && -t 1 ]]; then
            local ans=""
            echo ""
            read -r -p "Download PDF for '$id'? [y/N] " ans </dev/tty
            case "$ans" in
                [Yy]*) __preprint_download_entry "$db" "$id" "$out_path" ;;
            esac
        fi
    }

    # =========================================================================
    # CONFIGURATION MANAGEMENT ('preprint conf <ls|get|set|rm>')
    # =========================================================================
    __preprint_conf_ls() {
        __preprint_load_omnirc
        printf "%-14s %-18s %s\n" "PROVIDER" "STATUS" "CONFIGURED KEYS"
        printf "%-14s %-18s %s\n" "--------" "------" "---------------"
        local db pair k v
        for db in "${PREPRINT_PROVIDERS[@]}"; do
            if __preprint_is_profile_registered "$db"; then
                local -a keys=() pairs=()
                IFS=',' read -ra pairs <<< "${PREPRINT_CONF[$db]:-}"
                for pair in "${pairs[@]}"; do
                    k="${pair%%:*}"
                    v="${pair#*:}"
                    if [[ "$k" == "pass" || "$k" == "token" ]]; then
                        keys+=("${k}:*** (${#v} chars)")
                    elif [[ "$v" == *" "* ]]; then
                        keys+=("${k}:\"${v}\"")
                    else
                        keys+=("${k}:${v}")
                    fi
                done
                printf "%-14s %-18s %s\n" "$db" "registered" "${keys[*]:-(via env)}"
            else
                printf "%-14s %-18s %s\n" "$db" "not registered" "-"
            fi
        done
    }

    __preprint_conf_get() {
        __preprint_load_omnirc
        local raw_db=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) raw_db="$2"; shift 2 ;;
                --database=*)  raw_db="${1#*=}"; shift ;;
                -*)            shift ;;
                *)             [[ -z "$raw_db" ]] && raw_db="$1"; shift ;;
            esac
        done

        if [[ -z "$raw_db" ]]; then
            __preprint_conf_ls
            return $?
        fi

        local db="$(__preprint_norm_db "$raw_db")"
        __preprint_require_registered_profile "$db" || return 1

        local profile orcid user pass token sandbox
        profile="$(__preprint_get_conf "$db" profile)"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf "$db" author)"
        orcid="$(__preprint_get_conf "$db" orcid)"
        user="$(__preprint_get_conf "$db" user)"
        pass="$(__preprint_get_conf "$db" pass)"
        token="$(__preprint_get_conf "$db" token)"
        sandbox="$(__preprint_get_conf "$db" sandbox)"
        [[ -z "$sandbox" ]] && sandbox="false"

        printf "Provider:  %s\n" "$db"
        printf "Status:    registered\n"
        printf "Profile:   %s\n" "${profile:--}"
        printf "ORCID:     %s\n" "${orcid:--}"
        printf "User:      %s\n" "${user:--}"
        if [[ -n "$pass" ]]; then
            printf "Password:  *** (%d chars)\n" "${#pass}"
        else
            printf "Password:  -\n"
        fi
        if [[ -n "$token" ]]; then
            printf "Token:     *** (%d chars)\n" "${#token}"
        else
            printf "Token:     -\n"
        fi
        printf "Sandbox:   %s\n" "$sandbox"
    }

    __preprint_conf_set() {
        __preprint_load_omnirc
        local raw_db="" has_flags=0
        local -a rem_args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) raw_db="$2"; shift 2 ;;
                --database=*)  raw_db="${1#*=}"; shift ;;
                -*)            has_flags=1; rem_args+=("$1"); shift ;;
                *)
                    if [[ -z "$raw_db" && $has_flags -eq 0 ]]; then
                        raw_db="$1"
                    else
                        rem_args+=("$1")
                    fi
                    shift
                    ;;
            esac
        done
        set -- "${rem_args[@]}"

        if [[ -z "$raw_db" ]]; then
            __log "Usage: preprint conf set <provider> [--profile <id>] [--orcid <id>] [--token <tok>] [--user <u>] [--pass <p>] [--sandbox|--no-sandbox]" -t error -l preprint
            return 1
        fi

        local db="$(__preprint_norm_db "$raw_db")"
        __preprint_require_provider "$db" || return 1

        local token user pass orcid profile sandbox
        token="$(__preprint_get_conf "$db" token)"
        user="$(__preprint_get_conf "$db" user)"
        pass="$(__preprint_get_conf "$db" pass)"
        orcid="$(__preprint_get_conf "$db" orcid)"
        profile="$(__preprint_get_conf "$db" profile)"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf "$db" author)"
        sandbox="$(__preprint_get_conf "$db" sandbox)"
        [[ -z "$sandbox" ]] && sandbox="false"

        if (( has_flags == 0 )) && [[ -t 0 && -t 1 ]]; then
            echo "Configuring '$db' (press Enter to keep current value, type '-' to clear):"
            local in_val=""
            read -r -p "  Profile ID [${profile:--}]: " in_val </dev/tty
            [[ "$in_val" == "-" ]] && profile="" || [[ -n "$in_val" ]] && profile="$in_val"

            read -r -p "  ORCID iD [${orcid:--}]: " in_val </dev/tty
            [[ "$in_val" == "-" ]] && orcid="" || [[ -n "$in_val" ]] && orcid="$in_val"

            read -r -p "  Username [${user:--}]: " in_val </dev/tty
            [[ "$in_val" == "-" ]] && user="" || [[ -n "$in_val" ]] && user="$in_val"

            read -r -s -p "  Password [$( [[ -n "$pass" ]] && echo "***" || echo "-" )]: " in_val </dev/tty
            echo ""
            [[ "$in_val" == "-" ]] && pass="" || [[ -n "$in_val" ]] && pass="$in_val"

            read -r -s -p "  API Token [$( [[ -n "$token" ]] && echo "***" || echo "-" )]: " in_val </dev/tty
            echo ""
            [[ "$in_val" == "-" ]] && token="" || [[ -n "$in_val" ]] && token="$in_val"

            read -r -p "  Sandbox (true/false) [${sandbox}]: " in_val </dev/tty
            if [[ "$in_val" == "true" || "$in_val" == "false" ]]; then
                sandbox="$in_val"
            fi
        else
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --token)            token="$2"; shift 2 ;;
                    --token=*)          token="${1#*=}"; shift ;;
                    --user)             user="$2"; shift 2 ;;
                    --user=*)           user="${1#*=}"; shift ;;
                    --pass)             pass="$2"; shift 2 ;;
                    --pass=*)           pass="${1#*=}"; shift ;;
                    --orcid)            orcid="$2"; shift 2 ;;
                    --orcid=*)          orcid="${1#*=}"; shift ;;
                    --profile|--author) profile="$2"; shift 2 ;;
                    --profile=*|--author=*) profile="${1#*=}"; shift ;;
                    --sandbox)          sandbox="true"; shift ;;
                    --no-sandbox)       sandbox="false"; shift ;;
                    *) shift ;;
                esac
            done
        fi

        local val="sandbox:$sandbox"
        [[ -n "$profile" ]] && val+=",profile:$profile"
        [[ -n "$orcid" ]]   && val+=",orcid:$orcid"
        [[ -n "$user" ]]    && val+=",user:$user"
        [[ -n "$pass" ]]    && val+=",pass:$pass"
        [[ -n "$token" ]]   && val+=",token:$token"

        PREPRINT_CONF["$db"]="$val"
        __preprint_save_omnirc
        __log "Configuration for '$db' updated." -t success -l preprint
    }

    __preprint_conf_rm() {
        __preprint_load_omnirc
        local raw_db=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) raw_db="$2"; shift 2 ;;
                --database=*)  raw_db="${1#*=}"; shift ;;
                *) [[ -z "$raw_db" ]] && raw_db="$1"; shift ;;
            esac
        done
        [[ -z "$raw_db" ]] && { __log "Usage: preprint conf rm <provider>" -t error -l preprint; return 1; }
        local db="$(__preprint_norm_db "$raw_db")"
        unset "PREPRINT_CONF[$db]"
        __preprint_save_omnirc
        __log "Configuration for '$db' removed." -t success -l preprint
    }

    __preprint_conf() {
        local action="${1:-ls}"
        if [[ "$action" == "-h" || "$action" == "--help" ]]; then
            cat <<'EOF' >&2
USAGE:
    preprint conf ls
    preprint conf get [<provider>]
    preprint conf set <provider> [--profile <id>] [--orcid <id>] [--token <tok>] [--user <u>] [--pass <p>] [--sandbox|--no-sandbox]
    preprint conf rm <provider>
EOF
            return 0
        fi
        shift || true

        case "$action" in
            ls|list)
                __preprint_conf_ls "$@"
                ;;
            get|show)
                __preprint_conf_get "$@"
                ;;
            set|new|edit)
                __preprint_conf_set "$@"
                ;;
            rm|remove|del|delete)
                __preprint_conf_rm "$@"
                ;;
            *)
                if __preprint_is_provider "$action"; then
                    __preprint_conf_get "$action" "$@"
                else
                    __log "Unknown conf command '$action'. Use: preprint conf <ls|get|set|rm> [<provider>]" -t error -l preprint
                    return 1
                fi
                ;;
        esac
    }

    __preprint_profile_legacy() {
        local sub="${1:-ls}"; shift || true
        case "$sub" in
            ls|list)        __preprint_list "$@" ;;
            add|send|push)  __preprint_send "$@" ;;
            rm|remove|del)  __preprint_rm "$@" ;;
            get|show)       __preprint_conf_get "$@" ;;
            edit|set)       __preprint_conf_set "$@" ;;
            *)              __preprint_list "$sub" "$@" ;;
        esac
    }

    # =========================================================================
    # PROFILE ENTRY COMMANDS ('preprint ls', 'preprint rm')
    # =========================================================================
    __preprint_list() {
        local db="" max=0 sort_by="time" reverse=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                entries)       shift ;;
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -n|--max)      max="$2"; shift 2 ;;
                --max=*)       max="${1#*=}"; shift ;;
                -s|--sort)     sort_by="$2"; shift 2 ;;
                --sort=*)      sort_by="${1#*=}"; shift ;;
                -r|--reverse)  reverse=1; shift ;;
                -*) shift ;;
                *) [[ -z "$db" ]] && db="$(__preprint_norm_db "$1")"; shift ;;
            esac
        done

        if [[ -z "$db" ]]; then
            __preprint_conf_ls
            return $?
        fi

        __preprint_require_registered_profile "$db" || return 1

        sort_by="$(__preprint_norm_sort "$sort_by")"
        local raw_out=""
        raw_out="$(__preprint_call "$db" list "$max" "$sort_by" "$reverse")" || return 1
        raw_out="$(__preprint_merge_profile_drafts "$db" "$raw_out")"

        if [[ -z "$raw_out" || "$raw_out" == "No "* ]]; then
            echo "${raw_out:-No entries found.}"
            return 0
        fi
        __preprint_sort_lines "$sort_by" "$reverse" <<< "$raw_out"
    }

    __preprint_rm() {
        local db="" entry_id=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -*) shift ;;
                *)
                    if [[ -z "$db" ]] && __preprint_is_provider "$1"; then
                        db="$(__preprint_norm_db "$1")"
                    elif [[ -z "$entry_id" ]]; then
                        entry_id="$1"
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$db" ]]; then
            __log "Usage: preprint rm [<entry_id>] -d/--database <provider>" -t error -l preprint
            return 1
        fi
        __preprint_require_registered_profile "$db" || return 1

        if [[ -z "$entry_id" ]]; then
            if ! command -v fzf >/dev/null 2>&1; then
                __log "Pass <entry_id> to remove or install 'fzf' for interactive selection." -t error -l preprint
                return 1
            fi
            local entries selected
            entries="$(__preprint_list "$db")" || return 1
            if [[ -z "$entries" || "$entries" == "No "* ]]; then
                __log "No entries found in '$db' profile." -t info -l preprint
                return 1
            fi
            selected=$(printf '%s\n' "$entries" | fzf --header="Select entry to REMOVE from $db profile" --prompt="Remove from $db > " --height=50% --layout=reverse --border)
            [[ -z "$selected" ]] && return 0
            if [[ "$selected" =~ ^\[([^]]+)\] ]]; then
                entry_id="${BASH_REMATCH[1]}"
            else
                entry_id="${selected%% *}"
            fi
        fi

        __preprint_call "$db" rm "$entry_id"
        __preprint_draft_rm "$db" "${entry_id#hexagon:}"
    }

    # =========================================================================
    # GENERIC COMMAND DISPATCHERS ('get', 'search', 'send', 'publish')
    # =========================================================================
    __preprint_get() {
        local target="" db="" max=0 sort_by="time" reverse=0 download=0 out_path="" used_fzf=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -D|--download) download=1; shift ;;
                -o|--output)   out_path="$2"; shift 2 ;;
                --output=*)    out_path="${1#*=}"; shift ;;
                -n|--max)      max="$2"; shift 2 ;;
                --max=*)       max="${1#*=}"; shift ;;
                -s|--sort)     sort_by="$2"; shift 2 ;;
                --sort=*)      sort_by="${1#*=}"; shift ;;
                -r|--reverse)  reverse=1; shift ;;
                -*) shift ;;
                *) [[ -z "$target" ]] && target="$1"; shift ;;
            esac
        done

        if [[ -z "$db" ]]; then
            __log "Usage: preprint get [<id>] -d/--database <provider> [-D/--download] [-o/--output <path>]" -t error -l preprint
            return 1
        fi
        __preprint_require_provider "$db" || return 1

        if [[ -z "$target" ]]; then
            __preprint_require_registered_profile "$db" || return 1
            if ! command -v fzf >/dev/null 2>&1; then
                __log "missing 'fzf' for interactive selection (pass <id> or install fzf)." -t error -l preprint
                return 1
            fi
            local entries fzf_out key selected rev_flag=()
            (( reverse == 1 )) && rev_flag=(-r)
            entries="$(__preprint_list "$db" -n "$max" -s "$sort_by" "${rev_flag[@]}")" || return 1
            if [[ -z "$entries" || "$entries" == "No "* ]]; then
                __log "No entries found in '$db' profile." -t info -l preprint
                return 1
            fi
            fzf_out=$(printf '%s\n' "$entries" | fzf --expect=ctrl-d --header="[ID] (Date) Title   Authors  |  Enter: details  |  Ctrl-D: download PDF" --prompt="Select $db entry > " --height=50% --layout=reverse --border)
            [[ -z "$fzf_out" ]] && return 0

            key="${fzf_out%%$'\n'*}"
            selected="${fzf_out#*$'\n'}"
            [[ "$key" == "$fzf_out" ]] && { key=""; selected="$fzf_out"; }
            [[ -z "$selected" ]] && return 0

            if [[ "$selected" =~ ^\[([^]]+)\] ]]; then
                target="${BASH_REMATCH[1]}"
            else
                target="${selected%% *}"
            fi

            if [[ "$key" == "ctrl-d" ]]; then
                __preprint_download_entry "$db" "$target" "$out_path"
                return $?
            fi
            used_fzf=1
        fi

        if __preprint_call "$db" get "$target"; then
            if (( download == 1 || used_fzf == 1 )); then
                __preprint_prompt_download "$db" "$target" "$download" "$out_path"
            fi
        else
            return 1
        fi
    }

    __preprint_search() {
        local term="" db="" page_size=50 no_fzf=0 sort_by="time" reverse=0 download=0 out_path=""
        local -a pos_args=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -D|--download) download=1; shift ;;
                -o|--output)   out_path="$2"; shift 2 ;;
                --output=*)    out_path="${1#*=}"; shift ;;
                -n|--max)      page_size="$2"; shift 2 ;;
                --max=*)       page_size="${1#*=}"; shift ;;
                -s|--sort)     sort_by="$2"; shift 2 ;;
                --sort=*)      sort_by="${1#*=}"; shift ;;
                -r|--reverse)  reverse=1; shift ;;
                -l|--no-fzf)   no_fzf=1; shift ;;
                -*) shift ;;
                *)
                    pos_args+=("$1")
                    shift
                    ;;
            esac
        done

        if [[ -z "$db" && ${#pos_args[@]} -ge 2 ]]; then
            local last_idx=$(( ${#pos_args[@]} - 1 ))
            local last_arg="${pos_args[$last_idx]}"
            if __preprint_is_provider "$last_arg"; then
                db="$(__preprint_norm_db "$last_arg")"
                unset "pos_args[$last_idx]"
            fi
        fi

        local OIFS="$IFS"
        IFS=' '
        term="${pos_args[*]}"
        IFS="$OIFS"

        [[ -z "$term" || -z "$db" ]] && {
            __log "Usage: preprint search <terms...> [-d/--database] <provider> [-D/--download] [-s/--sort <time|alpha>] [-r/--reverse]" -t error -l preprint
            return 1
        }
        __preprint_require_provider "$db" || return 1

        (( page_size <= 0 )) && page_size=50
        sort_by="$(__preprint_norm_sort "$sort_by")"
        local pagination_mode="${PREPRINT_PROVIDER_META["${db}:pagination"]:-offset}"

        local page=1 cursor=0 results="" fzf_out="" key="" selected="" target="" count=0

        if (( no_fzf == 1 )) || [[ ! -t 1 ]] || ! command -v fzf >/dev/null 2>&1; then
            cursor=0
            [[ "$pagination_mode" == "page" ]] && cursor=1
            results="$(__preprint_call "$db" search "$term" "$page_size" "$cursor" "$sort_by" "$reverse")"
            if [[ -z "$results" || "$results" == "No "* ]]; then
                echo "${results:-No results found.}"
            else
                __preprint_sort_lines "$sort_by" "$reverse" <<< "$results"
            fi
            return 0
        fi

        while true; do
            if [[ "$pagination_mode" == "page" ]]; then
                cursor="$page"
            else
                cursor=$(( (page - 1) * page_size ))
            fi

            results="$(__preprint_call "$db" search "$term" "$page_size" "$cursor" "$sort_by" "$reverse")"

            if [[ -z "$results" || "$results" == "No "* ]]; then
                if (( page == 1 )); then
                    echo "${results:-No results found.}"
                    return 0
                else
                    __log "No more results beyond page $((page - 1))." -t info -l preprint
                    (( page-- ))
                    continue
                fi
            fi

            results="$(__preprint_sort_lines "$sort_by" "$reverse" <<< "$results")"
            count=$(printf '%s\n' "$results" | wc -l)

            local menu="$results"
            if (( page > 1 )); then
                menu=".."$'\n'"$menu"
            fi
            if (( count >= page_size )); then
                menu+=$'\n'"..."
            fi

            local order_label="newest"
            if [[ "$sort_by" == "time" && $reverse -eq 1 ]]; then order_label="oldest"
            elif [[ "$sort_by" == "alpha" && $reverse -eq 0 ]]; then order_label="A-Z"
            elif [[ "$sort_by" == "alpha" && $reverse -eq 1 ]]; then order_label="Z-A"; fi

            fzf_out=$(printf '%s\n' "$menu" | fzf --expect=ctrl-d --header="[ID] (Date) Title   Authors  |  Enter: details  |  Ctrl-D: download PDF" --prompt="Search $db [page $page | $order_label] > " --height=60% --layout=reverse --border)
            [[ -z "$fzf_out" ]] && return 0

            key="${fzf_out%%$'\n'*}"
            selected="${fzf_out#*$'\n'}"
            [[ "$key" == "$fzf_out" ]] && { key=""; selected="$fzf_out"; }
            [[ -z "$selected" ]] && return 0

            if [[ "$selected" == "..." ]]; then
                (( page++ ))
                continue
            elif [[ "$selected" == ".." ]]; then
                (( page > 1 )) && (( page-- ))
                continue
            fi
            break
        done

        if [[ "$selected" =~ ^\[([^]]+)\] ]]; then
            target="${BASH_REMATCH[1]}"
        else
            target="${selected%% *}"
        fi

        if declare -f "__preprint_provider_${db}_on_select" >/dev/null 2>&1; then
            "__preprint_provider_${db}_on_select" "$target" "$selected" "$key" "$sort_by" "$reverse" "$download" "$out_path"
            return $?
        fi

        if [[ "$key" == "ctrl-d" ]]; then
            __preprint_download_entry "$db" "$target" "$out_path"
            return $?
        fi

        if __preprint_call "$db" get "$target"; then
            __preprint_prompt_download "$db" "$target" "$download" "$out_path"
        else
            return 1
        fi
    }

    __preprint_send() {
        local PREPRINT_SEND_FILE="" db="" PREPRINT_SEND_META="" PREPRINT_SEND_TITLE=""
        local PREPRINT_SEND_AUTHOR="" PREPRINT_SEND_AFFILIATIONS="" PREPRINT_SEND_EMAILS=""
        local PREPRINT_SEND_ABSTRACT="" PREPRINT_SEND_CATEGORY=""
        local PREPRINT_SEND_MSC="" PREPRINT_SEND_KEYWORDS=""
        local PREPRINT_SEND_DOI="" PREPRINT_SEND_URL="" PREPRINT_SEND_JOURNAL=""
        local PREPRINT_SEND_TYPE="preprint" PREPRINT_SEND_DATE="" auto_yes=0
        declare -A PREPRINT_SEND_EXT_IDS=()

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database)    db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)     db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -y|--yes)         auto_yes=1; shift ;;
                -m|--meta)        PREPRINT_SEND_META="$2"; shift 2 ;;
                --meta=*)         PREPRINT_SEND_META="${1#*=}"; shift ;;
                -t|--title)       PREPRINT_SEND_TITLE="$2"; shift 2 ;;
                --title=*)        PREPRINT_SEND_TITLE="${1#*=}"; shift ;;
                -a|--author)      PREPRINT_SEND_AUTHOR="$2"; shift 2 ;;
                --author=*)       PREPRINT_SEND_AUTHOR="${1#*=}"; shift ;;
                --affiliation|--address) PREPRINT_SEND_AFFILIATIONS="$2"; shift 2 ;;
                --affiliation=*|--address=*) PREPRINT_SEND_AFFILIATIONS="${1#*=}"; shift ;;
                --email)          PREPRINT_SEND_EMAILS="$2"; shift 2 ;;
                --email=*)        PREPRINT_SEND_EMAILS="${1#*=}"; shift ;;
                -A|--abstract)    PREPRINT_SEND_ABSTRACT="$2"; shift 2 ;;
                --abstract=*)     PREPRINT_SEND_ABSTRACT="${1#*=}"; shift ;;
                -c|--category)    PREPRINT_SEND_CATEGORY="$2"; shift 2 ;;
                --category=*)     PREPRINT_SEND_CATEGORY="${1#*=}"; shift ;;
                --msc)            PREPRINT_SEND_MSC="$2"; shift 2 ;;
                --msc=*)          PREPRINT_SEND_MSC="${1#*=}"; shift ;;
                --keywords)       PREPRINT_SEND_KEYWORDS="$2"; shift 2 ;;
                --keywords=*)     PREPRINT_SEND_KEYWORDS="${1#*=}"; shift ;;
                --doi)            PREPRINT_SEND_DOI="$2"; PREPRINT_SEND_EXT_IDS["doi"]="$2"; shift 2 ;;
                --doi=*)          PREPRINT_SEND_DOI="${1#*=}"; PREPRINT_SEND_EXT_IDS["doi"]="${1#*=}"; shift ;;
                --url)            PREPRINT_SEND_URL="$2"; shift 2 ;;
                --url=*)          PREPRINT_SEND_URL="${1#*=}"; shift ;;
                --journal)        PREPRINT_SEND_JOURNAL="$2"; shift 2 ;;
                --journal=*)      PREPRINT_SEND_JOURNAL="${1#*=}"; shift ;;
                --type)           PREPRINT_SEND_TYPE="$2"; shift 2 ;;
                --type=*)         PREPRINT_SEND_TYPE="${1#*=}"; shift ;;
                --date)           PREPRINT_SEND_DATE="$2"; shift 2 ;;
                --date=*)         PREPRINT_SEND_DATE="${1#*=}"; shift ;;
                --id)
                    if [[ "$2" == *:* ]]; then
                        local k="$(__preprint_norm_db "${2%%:*}")"
                        PREPRINT_SEND_EXT_IDS["$k"]="${2#*:}"
                    fi
                    shift 2
                    ;;
                --id=*)
                    local kv="${1#*=}"
                    if [[ "$kv" == *:* ]]; then
                        local k="$(__preprint_norm_db "${kv%%:*}")"
                        PREPRINT_SEND_EXT_IDS["$k"]="${kv#*:}"
                    fi
                    shift
                    ;;
                -*)
                    __log "Unknown option '$1' for 'preprint send'." -t error -l preprint
                    return 1
                    ;;
                *)
                    [[ -z "$PREPRINT_SEND_FILE" ]] && PREPRINT_SEND_FILE="$1"
                    shift
                    ;;
            esac
        done

        [[ -z "$db" ]] && {
            __log "Usage: preprint send [<file>] [-c <category>] [-t <title>] [-a <authors>] [-A <abstract>] [-m <meta_file>] -d/--database <provider>" -t error -l preprint
            return 1
        }
        __preprint_require_registered_profile "$db" || return 1

        # 1. Load key:value pairs from -m <meta_file> if supplied
        if [[ -n "$PREPRINT_SEND_META" && -f "$PREPRINT_SEND_META" ]]; then
            __preprint_load_kv_meta "$PREPRINT_SEND_META"
        fi

        # 2. Verify target file existence if required by provider
        local req_file="${PREPRINT_PROVIDER_META["${db}:requires_file"]:-true}"
        if [[ "$req_file" == "true" && -z "$PREPRINT_SEND_FILE" ]]; then
            __log "Usage: preprint send <file> [metadata-options] -d/--database $db" -t error -l preprint
            return 1
        fi
        if [[ -n "$PREPRINT_SEND_FILE" && ! -e "$PREPRINT_SEND_FILE" ]]; then
            __log "File or directory not found: '$PREPRINT_SEND_FILE'" -t error -l preprint
            return 1
        fi

        # 3. Auto-extract title, author, affiliations, emails, abstract, MSC, and keywords ONLY when the passed file is a .tex file
        if [[ -n "$PREPRINT_SEND_FILE" && "$PREPRINT_SEND_FILE" == *.tex && -f "$PREPRINT_SEND_FILE" ]]; then
            [[ -z "$PREPRINT_SEND_TITLE" ]]        && PREPRINT_SEND_TITLE="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "title")"
            [[ -z "$PREPRINT_SEND_AUTHOR" ]]       && PREPRINT_SEND_AUTHOR="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "author")"
            [[ -z "$PREPRINT_SEND_AFFILIATIONS" ]] && PREPRINT_SEND_AFFILIATIONS="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "affiliation")"
            [[ -z "$PREPRINT_SEND_EMAILS" ]]       && PREPRINT_SEND_EMAILS="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "email")"
            [[ -z "$PREPRINT_SEND_ABSTRACT" ]]     && PREPRINT_SEND_ABSTRACT="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "abstract")"
            [[ -z "$PREPRINT_SEND_MSC" ]]          && PREPRINT_SEND_MSC="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "msc")"
            [[ -z "$PREPRINT_SEND_KEYWORDS" ]]     && PREPRINT_SEND_KEYWORDS="$(__preprint_extract_tex_meta "$PREPRINT_SEND_FILE" "keywords")"
        fi

        # 4. GLOBAL METADATA VALIDATION: Block sending for ALL providers if title, author, abstract (or required category) is missing!
        if ! __preprint_is_raw_payload_meta "$PREPRINT_SEND_META"; then
            local -a missing_meta=()
            if [[ "$PREPRINT_SEND_FILE" == *.tex ]]; then
                [[ -z "${PREPRINT_SEND_TITLE//[[:space:]]/}" ]]    && missing_meta+=("--title (-t) [could not auto-collect title from '$PREPRINT_SEND_FILE']")
                [[ -z "${PREPRINT_SEND_AUTHOR//[[:space:]]/}" ]]   && missing_meta+=("--author (-a) [could not auto-collect author from '$PREPRINT_SEND_FILE']")
                [[ -z "${PREPRINT_SEND_ABSTRACT//[[:space:]]/}" ]] && missing_meta+=("--abstract (-A) [could not auto-collect abstract from '$PREPRINT_SEND_FILE']")
            else
                [[ -z "${PREPRINT_SEND_TITLE//[[:space:]]/}" ]]    && missing_meta+=("--title (-t) [required when file is not .tex]")
                [[ -z "${PREPRINT_SEND_AUTHOR//[[:space:]]/}" ]]   && missing_meta+=("--author (-a) [required when file is not .tex]")
                [[ -z "${PREPRINT_SEND_ABSTRACT//[[:space:]]/}" ]] && missing_meta+=("--abstract (-A) [required when file is not .tex]")
            fi

            local req_cat="${PREPRINT_PROVIDER_META["${db}:requires_category"]:-false}"
            if [[ "$req_cat" == "true" && -z "${PREPRINT_SEND_CATEGORY//[[:space:]]/}" ]]; then
                missing_meta+=("--category (-c)")
            fi

            if (( ${#missing_meta[@]} > 0 )); then
                __log "Refusing to send to '$db' — missing required metadata:" -t error -l preprint
                local mm
                for mm in "${missing_meta[@]}"; do
                    __log "  - Missing $mm" -t error -l preprint
                done
                return 1
            fi
        fi

        [[ -z "$PREPRINT_SEND_DATE" ]] && printf -v PREPRINT_SEND_DATE "%(%Y-%m-%d)T" -1

        # 5. CONFIRMATION SCREEN: Display all collected information & passed attributes before sending
        local ext_ids_str="" ek
        for ek in "${!PREPRINT_SEND_EXT_IDS[@]}"; do
            ext_ids_str+="${ext_ids_str:+, }${ek}:${PREPRINT_SEND_EXT_IDS[$ek]}"
        done

        local file_info="${PREPRINT_SEND_FILE:--}"
        if [[ -n "$PREPRINT_SEND_FILE" && -f "$PREPRINT_SEND_FILE" ]]; then
            local fbytes
            fbytes=$(wc -c < "$PREPRINT_SEND_FILE" | tr -d '[:space:]')
            file_info="${PREPRINT_SEND_FILE} (${fbytes} bytes)"
        fi

        local -a auth_arr=() aff_arr=() em_arr=()
        IFS=';' read -ra auth_arr <<< "$PREPRINT_SEND_AUTHOR"
        IFS=';' read -ra aff_arr  <<< "$PREPRINT_SEND_AFFILIATIONS"
        IFS=';' read -ra em_arr   <<< "$PREPRINT_SEND_EMAILS"

        echo "========================================================================"
        echo "                 PREPRINT SUBMISSION CONFIRMATION"
        echo "========================================================================"
        printf "  %-13s %s\n" "Provider:" "$db"
        printf "  %-13s %s\n" "Target File:" "$file_info"
        [[ -n "$PREPRINT_SEND_META" ]]     && printf "  %-13s %s\n" "Meta File:" "$PREPRINT_SEND_META"
        printf "  %-13s %s\n" "Title:" "${PREPRINT_SEND_TITLE:--}"
        if (( ${#auth_arr[@]} == 0 )); then
            printf "  %-13s %s\n" "Authors:" "-"
        else
            local idx a_name a_aff a_em a_line
            for (( idx=0; idx<${#auth_arr[@]}; idx++ )); do
                a_name="${auth_arr[$idx]#"${auth_arr[$idx]%%[![:space:]]*}"}"
                a_name="${a_name%"${a_name##*[![:space:]]}"}"
                a_aff="${aff_arr[$idx]:-}"
                a_aff="${a_aff#"${a_aff%%[![:space:]]*}"}"
                a_aff="${a_aff%"${a_aff##*[![:space:]]}"}"
                a_em="${em_arr[$idx]:-}"
                a_em="${a_em#"${a_em%%[![:space:]]*}"}"
                a_em="${a_em%"${a_em##*[![:space:]]}"}"
                a_line="$a_name"
                [[ -n "$a_aff" ]] && a_line+=" (${a_aff})"
                [[ -n "$a_em" ]]  && a_line+=" <${a_em}>"
                if (( idx == 0 )); then
                    printf "  %-13s %s\n" "Authors:" "$a_line"
                else
                    printf "  %-13s %s\n" "" "$a_line"
                fi
            done
        fi
        printf "  %-13s %s\n" "Category:" "${PREPRINT_SEND_CATEGORY:--}"
        [[ -n "$PREPRINT_SEND_MSC" ]]      && printf "  %-13s %s\n" "MSC (2020):" "$PREPRINT_SEND_MSC"
        [[ -n "$PREPRINT_SEND_KEYWORDS" ]] && printf "  %-13s %s\n" "Keywords:" "$PREPRINT_SEND_KEYWORDS"
        [[ -n "$PREPRINT_SEND_DOI" ]]      && printf "  %-13s %s\n" "DOI:" "$PREPRINT_SEND_DOI"
        [[ -n "$PREPRINT_SEND_URL" ]]      && printf "  %-13s %s\n" "URL:" "$PREPRINT_SEND_URL"
        [[ -n "$PREPRINT_SEND_JOURNAL" ]]  && printf "  %-13s %s\n" "Journal:" "$PREPRINT_SEND_JOURNAL"
        [[ -n "$ext_ids_str" ]]            && printf "  %-13s %s\n" "External IDs:" "$ext_ids_str"
        printf "  %-13s %s\n" "Work Type:" "${PREPRINT_SEND_TYPE:-preprint}"
        printf "  %-13s %s\n" "Date:" "${PREPRINT_SEND_DATE}"
        echo "------------------------------------------------------------------------"
        echo "  Abstract:"
        if command -v fold >/dev/null 2>&1; then
            printf '%s\n' "${PREPRINT_SEND_ABSTRACT:--}" | fold -s -w 68 | sed 's/^/    /'
        else
            printf '    %s\n' "${PREPRINT_SEND_ABSTRACT:--}"
        fi
        echo "========================================================================"

        if (( auto_yes == 0 )) && [[ -t 0 && -t 1 ]]; then
            local confirm_ans=""
            read -r -p "Proceed with sending to '$db'? [y/N] " confirm_ans </dev/tty
            case "$confirm_ans" in
                [Yy]*) ;;
                *)
                    __log "Submission to '$db' cancelled by user." -t info -l preprint
                    return 0
                    ;;
            esac
        fi

        __preprint_call "$db" send
    }

    __preprint_publish() {
        local target="" db=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -d|--database) db="$(__preprint_norm_db "$2")"; shift 2 ;;
                --database=*)  db="$(__preprint_norm_db "${1#*=}")"; shift ;;
                -*) shift ;;
                *)
                    if [[ -z "$db" ]] && __preprint_is_provider "$1" && [[ -n "$target" ]]; then
                        db="$(__preprint_norm_db "$1")"
                    elif [[ -z "$target" ]]; then
                        target="$1"
                    elif [[ -z "$db" ]] && __preprint_is_provider "$1"; then
                        db="$(__preprint_norm_db "$1")"
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$db" && -n "$target" ]] && __preprint_is_provider "$target"; then
            db="$(__preprint_norm_db "$target")"
            target=""
        fi

        if [[ -z "$db" ]]; then
            __log "Usage: preprint publish [<id>] -d/--database <provider>" -t error -l preprint
            return 1
        fi
        __preprint_require_registered_profile "$db" || return 1

        if ! declare -f "__preprint_provider_${db}_publish" >/dev/null 2>&1; then
            __log "Provider '$db' does not support staged draft publishing." -t error -l preprint
            return 1
        fi

        local all_entries draft_entries
        all_entries="$(__preprint_list "$db" 2>/dev/null)"
        draft_entries=$(LC_ALL=C awk '/\[DRAFT\]/ { print $0 }' <<< "$all_entries")

        if [[ -z "$target" ]]; then
            if [[ -z "$draft_entries" ]]; then
                __log "No [DRAFT] entries found in '$db' profile to publish." -t info -l preprint
                return 1
            fi
            if ! command -v fzf >/dev/null 2>&1; then
                __log "Draft entries in '$db' (pass <id> to 'preprint publish <id> -d $db'):" -t info -l preprint
                echo "$draft_entries"
                return 1
            fi
            local selected
            selected=$(printf '%s\n' "$draft_entries" | fzf --header="Select [DRAFT] entry to PUBLISH on $db" --prompt="Publish $db draft > " --height=50% --layout=reverse --border)
            [[ -z "$selected" ]] && return 0
            if [[ "$selected" =~ ^\[([^]]+)\] ]]; then
                target="${BASH_REMATCH[1]}"
            else
                target="${selected%% *}"
            fi
        else
            local clean_target="${target#hexagon:}"
            local is_listed_published=0 is_listed_draft=0
            if [[ -n "$all_entries" ]]; then
                while IFS= read -r line; do
                    if [[ "$line" =~ ^\[([^]]+)\] ]]; then
                        local lid="${BASH_REMATCH[1]#hexagon:}"
                        if [[ "$lid" == "$clean_target" || "${BASH_REMATCH[1]}" == "$target" ]]; then
                            if [[ "$line" == *"[DRAFT]"* ]]; then
                                is_listed_draft=1
                            else
                                is_listed_published=1
                            fi
                        fi
                    fi
                done <<< "$all_entries"
            fi

            if (( is_listed_published == 1 && is_listed_draft == 0 )) && ! __preprint_draft_get "$db" "$clean_target" >/dev/null 2>&1; then
                __log "Refusing to publish '$target' on '$db': entry is already published (not in [DRAFT] state)." -t error -l preprint
                return 1
            fi
        fi

        if __preprint_call "$db" publish "$target"; then
            __preprint_draft_rm "$db" "${target#hexagon:}"
            return 0
        fi
        return 1
    }
}
