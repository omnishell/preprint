#! /bin/bash

__semantic__() {
    __preprint_register_provider "semantic" \
        --aliases "s2,semanticscholar,semantic-scholar,semantic" \
        --pagination "offset" \
        --requires-file "false" \
        --desc "Semantic Scholar Academic Graph API (search, author profile works, OA PDFs)"

    __preprint_semantic_cache_file() {
        echo "${TMPDIR:-/tmp}/preprint_semantic_cache_${USER:-0}.json"
    }

    __preprint_parse_semantic_json() {
        local mode="${1:-compact}" target_id="${2:-}"
        LC_ALL=C awk -v mode="$mode" -v target_id="$target_id" '
            function unesc(s) {
                gsub(/\\"/, "\"", s)
                gsub(/\\\\/, "\\", s)
                gsub(/\\n/, " ", s)
                gsub(/\\r/, "", s)
                gsub(/\\t/, " ", s)
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s)
                return s
            }
            function get_str(chunk, key,    pat, s) {
                pat = "\"" key "\"[ \t]*:[ \t]*\""
                if (match(chunk, pat "(\\\\.|[^\"\\\\])*\"")) {
                    s = substr(chunk, RSTART, RLENGTH)
                    sub("^" pat, "", s)
                    sub(/"$/, "", s)
                    return unesc(s)
                }
                return ""
            }
            function get_num(chunk, key,    pat, s) {
                pat = "\"" key "\"[ \t]*:[ \t]*[0-9]+"
                if (match(chunk, pat)) {
                    s = substr(chunk, RSTART, RLENGTH)
                    sub("^.*:[ \t]*", "", s)
                    return s
                }
                return ""
            }
            function get_authors(chunk,    s, out, pat, m) {
                out = ""
                if (match(chunk, /"authors"[ \t]*:[ \t]*\[[^\]]*\]/)) {
                    s = substr(chunk, RSTART, RLENGTH)
                    pat = "\"name\"[ \t]*:[ \t]*\"(\\\\.|[^\"\\\\])*\""
                    while (match(s, pat)) {
                        m = substr(s, RSTART, RLENGTH)
                        s = substr(s, RSTART + RLENGTH)
                        sub(/^"name"[ \t]*:[ \t]*"/, "", m)
                        sub(/"$/, "", m)
                        out = (out == "" ? unesc(m) : out ", " unesc(m))
                    }
                }
                if (out == "") out = get_str(chunk, "authorsYear")
                return out
            }
            function print_detailed(chunk,    pid, title, pub, venue, cites, url, doi, arx, abs, authors, pdf, oa_chunk) {
                pid = get_str(chunk, "paperId")
                if (pid == "") pid = get_str(chunk, "id")
                if (pid == "") return 0
                title = get_str(chunk, "title"); if (title == "") title = "Untitled"
                pub = get_str(chunk, "publicationDate")
                if (pub == "") pub = get_num(chunk, "year")
                if (pub == "") pub = "N/A"
                venue = get_str(chunk, "venue"); if (venue == "") venue = "N/A"
                cites = get_num(chunk, "citationCount")
                if (cites == "") cites = get_num(chunk, "numCitedBy")
                if (cites == "") cites = "0"
                url = get_str(chunk, "url"); if (url == "") url = "https://www.semanticscholar.org/paper/" pid
                doi = get_str(chunk, "DOI")
                if (doi == "") doi = get_str(chunk, "doi")
                if (doi == "") doi = "N/A"
                arx = get_str(chunk, "ArXiv")
                if (arx == "") arx = get_str(chunk, "arxivId")
                if (arx == "") arx = "N/A"
                abs = get_str(chunk, "abstract")
                if (abs == "") abs = get_str(chunk, "description")
                if (abs == "") abs = "N/A"
                authors = get_authors(chunk); if (authors == "") authors = "Unknown Author"
                pdf = ""
                if (match(chunk, /"openAccessPdf"[ \t]*:[ \t]*\{[^}]*\}/)) {
                    oa_chunk = substr(chunk, RSTART, RLENGTH)
                    pdf = get_str(oa_chunk, "url")
                }
                if (pdf == "" && arx != "N/A") pdf = "https://arxiv.org/pdf/" arx ".pdf"
                printf "PaperId:   %s\nTitle:     %s\nPublished: %s\nAuthors:   %s\nVenue:     %s\nCitations: %s\nDOI:       %s\nArXiv:     %s\nURL:       %s\nPDF:       %s\nAbstract:\n  %s\n", pid, title, pub, authors, venue, cites, doi, arx, url, (pdf ? pdf : "N/A"), abs
                return 1
            }
            function print_pdf(chunk,    pdf, arx, doi) {
                pdf = ""
                if (match(chunk, /"openAccessPdf"[ \t]*:[ \t]*\{[^}]*\}/)) {
                    pdf = get_str(substr(chunk, RSTART, RLENGTH), "url")
                }
                arx = get_str(chunk, "ArXiv")
                if (arx == "") arx = get_str(chunk, "arxivId")
                doi = get_str(chunk, "DOI")
                if (doi == "") doi = get_str(chunk, "doi")
                printf "%s\t%s\t%s\n", (pdf != "" ? pdf : "-"), (arx != "" ? arx : "-"), (doi != "" ? doi : "-")
                return 1
            }
            { raw = raw $0 "\n" }
            END {
                # If target_id is specified, locate that specific paper chunk in cached/batch JSON
                if (target_id != "") {
                    idx = index(raw, "\"" target_id "\"")
                    if (idx > 0) {
                        start_pos = (idx > 800 ? idx - 800 : 1)
                        sub_chunk = substr(raw, start_pos, 8000)
                        # Trim at the next paperId if present after target_id
                        rel_idx = index(sub_chunk, "\"" target_id "\"")
                        after_id = substr(sub_chunk, rel_idx + length(target_id) + 2)
                        if (match(after_id, /"paperId"[ \t]*:[ \t]*"/)) {
                            sub_chunk = substr(sub_chunk, 1, rel_idx + length(target_id) + 1 + RSTART - 1)
                        }
                        if (mode == "detailed") {
                            if (print_detailed(sub_chunk)) exit 0
                        } else if (mode == "pdf") {
                            if (print_pdf(sub_chunk)) exit 0
                        }
                    }
                    exit 1
                }

                if (mode == "detailed") {
                    if (print_detailed(raw)) exit 0
                    exit 1
                }
                if (mode == "pdf") {
                    print_pdf(raw)
                    exit 0
                }

                n = split(raw, parts, /"title"[ \t]*:[ \t]*"/)
                if (n <= 1) exit 1
                count = 0
                for (i = 2; i <= n; i++) {
                    prev = parts[i - 1]
                    plen = length(prev)
                    pre_ctx = (plen > 500 ? substr(prev, plen - 500) : prev)
                    post_ctx = substr(parts[i], 1, 3500)
                    c = pre_ctx "\"title\":\"" post_ctx

                    pid = get_str(c, "paperId")
                    if (pid == "") pid = get_str(c, "id")
                    if (pid == "" || (pid in seen)) continue

                    title = get_str(c, "title")
                    if (title == "") continue
                    seen[pid] = 1

                    pub = get_str(c, "publicationDate")
                    if (pub == "") {
                        yr = get_num(c, "year")
                        pub = (yr != "" ? yr : "N/A")
                    }
                    authors = get_authors(c)
                    if (authors == "") authors = "Unknown Author"
                    printf "[%s] (%s) %s   %s\n", pid, pub, title, authors
                    count++
                }
                if (count == 0) exit 1
            }
        '
    }

    # Fetch paper JSON via:
    #   1. Graph v1 GET /graph/v1/paper/<id>
    #   2. Legacy v1 GET /v1/paper/<id> (separate rate-limit bucket!)
    #   3. Graph v1 POST /graph/v1/paper/batch
    __preprint_semantic_fetch_paper_json() {
        local id="$1" fields="$2"
        local token="${SEMANTIC_TOKEN:-${S2_TOKEN:-$(__preprint_get_conf semantic token)}}"
        local -a auth_hdr=()
        [[ -n "$token" ]] && auth_hdr=(-H "x-api-key: $token")

        local resp=""
        resp=$(curl -fsSL "${auth_hdr[@]}" "https://api.semanticscholar.org/graph/v1/paper/$(__preprint_urlencode "$id")?fields=${fields}" 2>/dev/null)
        if [[ -z "$resp" || "$resp" != *"\"paperId\""* ]]; then
            # Fallback 1: Legacy v1 API (https://api.semanticscholar.org/v1/paper/<id>)
            resp=$(curl -fsSL "${auth_hdr[@]}" "https://api.semanticscholar.org/v1/paper/$(__preprint_urlencode "$id")" 2>/dev/null)
        fi
        if [[ -z "$resp" || "$resp" != *"\"paperId\""* ]]; then
            # Fallback 2: POST /graph/v1/paper/batch
            resp=$(curl -fsSL -X POST "${auth_hdr[@]}" \
                -H "Content-Type: application/json" \
                -d "{\"ids\":[\"$(__preprint_json_escape "$id")\"]}" \
                "https://api.semanticscholar.org/graph/v1/paper/batch?fields=${fields}" 2>/dev/null)
        fi
        printf '%s' "$resp"
    }

    __preprint_provider_semantic_list() {
        local max="${1:-0}" sort_by="${2:-time}" reverse="${3:-0}"
        local limit=$(( max > 0 && max <= 1000 ? max : 200 ))
        local profile="${SEMANTIC_PROFILE:-${S2_PROFILE:-$(__preprint_get_conf semantic profile)}}"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf semantic author)"
        local token="${SEMANTIC_TOKEN:-${S2_TOKEN:-$(__preprint_get_conf semantic token)}}"

        if [[ -z "$profile" ]]; then
            __log "Set your Semantic Scholar Author ID first:
  preprint database set -d semantic --profile <author_id>" -t error -l preprint
            return 1
        fi

        local -a auth_hdr=()
        [[ -n "$token" ]] && auth_hdr=(-H "x-api-key: $token")
        local fields="paperId,title,abstract,year,publicationDate,venue,citationCount,authors,url,openAccessPdf,externalIds"
        local resp
        resp=$(curl -fsSL "${auth_hdr[@]}" "https://api.semanticscholar.org/graph/v1/author/${profile}/papers?fields=${fields}&limit=${limit}" 2>/dev/null)
        if [[ -n "$resp" ]]; then
            printf '%s' "$resp" > "$(__preprint_semantic_cache_file)"
            __preprint_parse_semantic_json "compact" <<< "$resp" && return 0
        fi
        echo "No entries found in Semantic Scholar."
    }

    __preprint_provider_semantic_get() {
        local id="$1"
        if [[ "$id" == W* || "$id" == https://openalex.org/* ]]; then
            __preprint_provider_openalex_get "$id"
            return $?
        fi

        local cache_file="$(__preprint_semantic_cache_file)"
        local out=""

        # 1. Check local search/list cache first (instant, 0 network calls, immune to HTTP 429)
        if [[ -f "$cache_file" ]]; then
            out="$(__preprint_parse_semantic_json "detailed" "$id" < "$cache_file" 2>/dev/null)"
            if [[ -n "$out" ]]; then
                echo "$out"
                return 0
            fi
        fi

        # 2. Query S2 APIs (Graph v1 -> Legacy v1 -> Batch v1)
        local fields="paperId,title,abstract,year,publicationDate,venue,citationCount,authors,url,openAccessPdf,externalIds"
        local json
        json="$(__preprint_semantic_fetch_paper_json "$id" "$fields")"
        if [[ -n "$json" ]]; then
            out="$(__preprint_parse_semantic_json "detailed" <<< "$json" 2>/dev/null)"
            if [[ -n "$out" ]]; then
                echo "$out"
                return 0
            fi
        fi

        __log "No entry found in Semantic Scholar for '$id'." -t error -l preprint
        return 1
    }

    __preprint_provider_semantic_search() {
        local term="$1" limit="${2:-25}" offset="${3:-0}" sort_by="${4:-time}" reverse="${5:-0}"
        (( limit > 100 )) && limit=100
        local enc_term=$(__preprint_urlencode "$term")
        local token="${SEMANTIC_TOKEN:-${S2_TOKEN:-$(__preprint_get_conf semantic token)}}"
        local -a auth_hdr=()
        [[ -n "$token" ]] && auth_hdr=(-H "x-api-key: $token")

        # Request full metadata fields during search and cache them so selecting an entry in fzf needs 0 extra API requests
        local fields="paperId,title,abstract,year,publicationDate,venue,citationCount,authors,url,openAccessPdf,externalIds"
        local cache_file="$(__preprint_semantic_cache_file)"
        local resp out=""

        # 1. Primary Graph API search
        resp=$(curl -fsSL "${auth_hdr[@]}" "https://api.semanticscholar.org/graph/v1/paper/search?query=${enc_term}&offset=${offset}&limit=${limit}&fields=${fields}" 2>/dev/null)
        if [[ -n "$resp" ]]; then
            out=$(__preprint_parse_semantic_json "compact" <<< "$resp" 2>/dev/null)
            [[ -n "$out" ]] && printf '%s' "$resp" > "$cache_file"
        fi

        # 2. Bulk Search API fallback (separate rate-limit bucket on S2)
        if [[ -z "$out" ]]; then
            resp=$(curl -fsSL "${auth_hdr[@]}" "https://api.semanticscholar.org/graph/v1/paper/search/bulk?query=${enc_term}&fields=${fields}" 2>/dev/null)
            if [[ -n "$resp" ]]; then
                out=$(__preprint_parse_semantic_json "compact" <<< "$resp" 2>/dev/null | head -n "$limit")
                [[ -n "$out" ]] && printf '%s' "$resp" > "$cache_file"
            fi
        fi

        # 3. Autocomplete endpoint fallback
        if [[ -z "$out" ]]; then
            resp=$(curl -fsSL "${auth_hdr[@]}" "https://api.semanticscholar.org/graph/v1/paper/autocomplete?query=${enc_term}" 2>/dev/null)
            if [[ -n "$resp" ]]; then
                out=$(__preprint_parse_semantic_json "compact" <<< "$resp" 2>/dev/null)
                [[ -n "$out" ]] && printf '%s' "$resp" > "$cache_file"
            fi
        fi

        # 4. OpenAlex fallback if all S2 endpoints return HTTP 429
        if [[ -z "$out" ]]; then
            local page=$(( (offset / (limit > 0 ? limit : 25)) + 1 ))
            out=$(__preprint_provider_openalex_search "$term" "$limit" "$page" "$sort_by" "$reverse" 2>/dev/null)
        fi

        if [[ -n "$out" && "$out" != "No "* ]]; then
            echo "$out"
        else
            echo "No entries found in Semantic Scholar."
        fi
    }

    __preprint_provider_semantic_download() {
        local id="$1" out_path="${2:-}"
        if [[ "$id" == W* || "$id" == https://openalex.org/* ]]; then
            __preprint_provider_openalex_download "$id" "$out_path"
            return $?
        fi

        local cache_file="$(__preprint_semantic_cache_file)"
        local pdf_url="" arx_id="" doi_id=""

        # 1. Check local cache first
        if [[ -f "$cache_file" ]]; then
            read -r pdf_url arx_id doi_id < <(__preprint_parse_semantic_json "pdf" "$id" < "$cache_file" 2>/dev/null)
        fi

        # 2. Fetch from API if not in cache
        if [[ ( -z "$pdf_url" || "$pdf_url" == "-" ) && ( -z "$arx_id" || "$arx_id" == "-" ) && ( -z "$doi_id" || "$doi_id" == "-" ) ]]; then
            local json
            json="$(__preprint_semantic_fetch_paper_json "$id" "openAccessPdf,externalIds")"
            if [[ -n "$json" ]]; then
                read -r pdf_url arx_id doi_id < <(__preprint_parse_semantic_json "pdf" <<< "$json")
            fi
        fi

        if [[ -n "$pdf_url" && "$pdf_url" != "-" ]]; then
            __preprint_save_pdf_stream "$pdf_url" "semantic_${id//\//_}.pdf" "$out_path"
            return $?
        elif [[ -n "$arx_id" && "$arx_id" != "-" ]]; then
            __preprint_download_entry "arxiv" "$arx_id" "$out_path"
            return $?
        elif [[ -n "$doi_id" && "$doi_id" != "-" ]]; then
            __preprint_resolve_doi_pdf "$doi_id" "$out_path" "semantic_${id//\//_}.pdf"
            return $?
        fi
        __log "No Open-Access PDF available for Semantic Scholar paper '$id'." -t error -l preprint
        return 1
    }
}
