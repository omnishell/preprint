#! /bin/bash

__hexagon__() {
    __preprint_register_provider "hexagon" \
        --aliases "hexagonmath,hexagon-math,hexagon math" \
        --pagination "offset" \
        --requires-file "true" \
        --desc "Hexagon Math preprint server (stage drafts via send, publish via publish)"

    __preprint_hexagon_base_url() {
        local sb
        sb="$(__preprint_get_conf hexagon sandbox)"
        if [[ "$sb" == "true" || "${HEXAGON_SANDBOX:-0}" == "1" ]]; then
            echo "${HEXAGON_API_URL:-https://sandbox.hexagonmath.org}"
        else
            echo "${HEXAGON_API_URL:-https://hexagonmath.org}"
        fi
    }

    __preprint_parse_hexagon() {
        local mode="${1:-compact}" base_url="${2:-https://hexagonmath.org}"
        LC_ALL=C awk -v mode="$mode" -v base_url="$base_url" '
            function unesc_json(s) {
                gsub(/\\"/, "\"", s); gsub(/\\\\/, "\\", s)
                gsub(/\\n/, " ", s); gsub(/\\r/, "", s); gsub(/\\t/, " ", s)
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s)
                return s
            }
            function get_json_str(chunk, key,    pat, s) {
                pat = "\"" key "\"[ \t]*:[ \t]*\""
                if (match(chunk, pat "(\\\\.|[^\"\\\\])*\"")) {
                    s = substr(chunk, RSTART, RLENGTH)
                    sub("^" pat, "", s); sub(/"$/, "", s)
                    return unesc_json(s)
                }
                return ""
            }
            function is_json_draft(chunk,    st) {
                st = tolower(get_json_str(chunk, "status"))
                if (st == "") st = tolower(get_json_str(chunk, "state"))
                if (st == "draft" || st == "unpublished" || st == "staged" || st == "in_progress" || st == "pending") return 1
                if (chunk ~ /"(published|is_published)"[ \t]*:[ \t]*false/) return 1
                return 0
            }
            function norm_date(d, id) {
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", d)
                if (match(d, /20[0-9]{2}-[0-9]{2}-[0-9]{2}/)) return substr(d, RSTART, 10)
                if (id ~ /^[0-9]{4}\./) return "20" substr(id, 1, 2) "-" substr(id, 3, 2)
                return "N/A"
            }
            function get_json_date(chunk, id,    d, keys, n, i) {
                n = split("submitted_at,submission_date,published_at,publication_date,released_at,created_at,updated_at,date", keys, ",")
                for (i = 1; i <= n; i++) {
                    d = get_json_str(chunk, keys[i])
                    if (d != "") return norm_date(d, id)
                }
                if (match(chunk, /"20[0-9]{2}-[0-9]{2}-[0-9]{2}(T[0-9:.+-Z]+)?"/)) {
                    return substr(chunk, RSTART + 1, 10)
                }
                return norm_date("", id)
            }
            function get_json_authors(chunk,    s, out, pat, m) {
                out = ""
                if (match(chunk, /"(contributors|authors|creators)"[ \t]*:[ \t]*\[[^\]]*\]/)) {
                    s = substr(chunk, RSTART, RLENGTH)
                    pat = "\"(name|full_name|display_name|author_name|credit_name)\"[ \t]*:[ \t]*\"(\\\\.|[^\"\\\\])*\""
                    while (match(s, pat)) {
                        m = substr(s, RSTART, RLENGTH)
                        s = substr(s, RSTART + RLENGTH)
                        sub(/^"[^"]+"[ \t]*:[ \t]*"/, "", m); sub(/"$/, "", m)
                        m = unesc_json(m)
                        if (m != "") out = (out == "" ? m : out ", " m)
                    }
                }
                if (out == "") out = get_json_str(chunk, "authors_text")
                if (out == "") out = get_json_str(chunk, "author")
                return out
            }
            function pick_best_id(chunk,    s, m, best, base) {
                s = chunk; best = ""
                while (match(s, /(hexagon:)?[0-9]{4}\.[0-9]{4,5}(v[0-9]+)?/)) {
                    m = substr(s, RSTART, RLENGTH)
                    sub(/^hexagon:/, "", m)
                    s = substr(s, RSTART + RLENGTH)
                    if (best == "") best = m
                    else {
                        base = best; sub(/v[0-9]+$/, "", base)
                        if (m ~ ("^" base "v[0-9]+$") && best !~ /v[0-9]+$/) best = m
                    }
                }
                if (best == "") best = get_json_str(chunk, "id")
                if (best == "") best = get_json_str(chunk, "work_id")
                sub(/^hexagon:/, "", best)
                return best
            }
            { raw = raw $0 "\n" }
            END {
                if (mode == "extract_id") {
                    id = pick_best_id(raw)
                    if (id != "") print id
                    exit 0
                }
                if (mode == "check_status") {
                    if (is_json_draft(raw)) print "draft"
                    else if (raw ~ /"(status|state)"[ \t]*:[ \t]*"published"/ || raw ~ /"(published|is_published)"[ \t]*:[ \t]*true/) print "published"
                    else print "unknown"
                    exit 0
                }
                if (raw ~ /^[ \t\r\n]*[\{\[]/) {
                    if (mode == "detailed") {
                        id = pick_best_id(raw)
                        if (id == "") exit 1
                        title = get_json_str(raw, "title"); if (title == "") title = "Untitled"
                        pub = get_json_date(raw, id)
                        authors = get_json_authors(raw); if (authors == "") authors = "Unknown Contributor"
                        cat = get_json_str(raw, "primary_category"); if (cat == "") cat = get_json_str(raw, "category"); if (cat == "") cat = "N/A"
                        abs = get_json_str(raw, "abstract"); if (abs == "") abs = get_json_str(raw, "summary")
                        st = (is_json_draft(raw) ? "DRAFT" : "PUBLISHED")
                        printf "ID:        hexagon:%s\nStatus:    %s\nTitle:     %s\nPublished: %s\nAuthors:   %s\nCategory:  %s\nURL:       %s/%s\nPDF:       %s/pdf/%s\nSource:    %s/src/%s/files\nAbstract:\n  %s\n", id, st, title, pub, authors, cat, base_url, id, base_url, id, base_url, id, abs
                        exit 0
                    }

                    n = split(raw, items, /\}[ \t\r\n]*,[ \t\r\n]*\{/)
                    if (n <= 1) {
                        n = split(raw, items, /"title"[ \t]*:/)
                        for (i = 2; i <= n; i++) {
                            prev_tail = substr(items[i - 1], (length(items[i - 1]) > 600 ? length(items[i - 1]) - 600 : 1))
                            items[i] = prev_tail "\"title\":" items[i]
                        }
                        start_idx = 2
                    } else {
                        start_idx = 1
                    }

                    count = 0
                    for (i = start_idx; i <= n; i++) {
                        chunk = items[i]
                        id = pick_best_id(chunk)
                        if (id == "") continue
                        base_id = id; sub(/v[0-9]+$/, "", base_id)
                        if (base_id in seen) continue
                        title = get_json_str(chunk, "title")
                        if (title == "") continue
                        seen[base_id] = 1
                        pub = get_json_date(chunk, id)
                        authors = get_json_authors(chunk)
                        if (authors == "") authors = "Unknown Contributor"
                        badge = (is_json_draft(chunk) ? "[DRAFT] " : "")
                        printf "[%s] (%s) %s%s   %s\n", id, pub, badge, title, authors
                        count++
                    }
                    if (count == 0) exit 1
                    exit 0
                }
                exit 1
            }
        '
    }

    __preprint_provider_hexagon_download() {
        local id="$1" out_path="${2:-}"
        local clean_id="${id#hexagon:}"
        clean_id="${clean_id%.pdf}"
        local base_url="$(__preprint_hexagon_base_url)"
        local pdf_url="${base_url}/pdf/${clean_id}"
        __preprint_save_pdf_stream "$pdf_url" "hexagon_${clean_id//\//_}.pdf" "$out_path" "${pdf_url}.pdf"
    }

    __preprint_provider_hexagon_list() {
        local max="${1:-0}" sort_by="${2:-time}" reverse="${3:-0}"
        local limit=$(( max > 0 ? max : 200 ))
        local base_url profile orcid token auth_header=()
        base_url="$(__preprint_hexagon_base_url)"
        profile="${HEXAGON_PROFILE:-$(__preprint_get_conf hexagon profile)}"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf hexagon author)"
        orcid="${HEXAGON_ORCID:-$(__preprint_get_conf hexagon orcid)}"
        [[ -z "$orcid" ]] && orcid="$(__preprint_get_conf orcid orcid)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        [[ -n "$token" ]] && auth_header=(-H "Authorization: Bearer $token")

        if [[ -z "$profile" && -z "$orcid" && -z "$token" ]]; then
            __log "Set your Hexagon User ID, ORCID iD, or API token first:
  preprint database set -d hexagon --profile <user_id> --token <token>" -t error -l preprint
            return 1
        fi

        local resp out=""
        if [[ -n "$profile" ]]; then
            if [[ "$profile" == user_* ]]; then
                resp=$(curl -fsSL "${auth_header[@]}" "${base_url}/api/v1/users/${profile}/works?include_drafts=true&limit=${limit}" 2>/dev/null)
            else
                local enc_prof=$(__preprint_urlencode "$profile")
                resp=$(curl -fsSL "${auth_header[@]}" "${base_url}/api/v1/works?author=${enc_prof}&include_drafts=true&limit=${limit}" 2>/dev/null)
            fi
            [[ -n "$resp" ]] && out=$(__preprint_parse_hexagon "compact" "$base_url" <<< "$resp" 2>/dev/null)
        fi

        if [[ -z "$out" && -n "$orcid" ]]; then
            local enc_orcid=$(__preprint_urlencode "$orcid")
            resp=$(curl -fsSL "${auth_header[@]}" "${base_url}/api/v1/works?orcid=${enc_orcid}&include_drafts=true&limit=${limit}" 2>/dev/null)
            [[ -n "$resp" ]] && out=$(__preprint_parse_hexagon "compact" "$base_url" <<< "$resp" 2>/dev/null)
        fi

        if [[ -n "$out" ]]; then
            (( max > 0 )) && head -n "$max" <<< "$out" || echo "$out"
            return 0
        fi
        echo "No entries found in Hexagon Math."
    }

    __preprint_provider_hexagon_get() {
        local id="${1#hexagon:}"
        local base_url token auth_header=()
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        [[ -n "$token" ]] && auth_header=(-H "Authorization: Bearer $token")

        local resp
        resp=$(curl -fsSL "${auth_header[@]}" -H "Accept: application/json" "${base_url}/api/v1/works/${id}" 2>/dev/null)
        if [[ -z "$resp" ]] || ! __preprint_parse_hexagon "detailed" "$base_url" <<< "$resp" 2>/dev/null; then
            echo "No entry found in Hexagon Math for '$id'."
            return 1
        fi
    }

    __preprint_provider_hexagon_search() {
        local term="$1" limit="${2:-50}" offset="${3:-0}" sort_by="${4:-time}" reverse="${5:-0}"
        local base_url="$(__preprint_hexagon_base_url)"
        local enc_term=$(__preprint_urlencode "$term")
        local resp out=""
        resp=$(curl -fsSL -H "Accept: application/json" "${base_url}/api/v1/works?q=${enc_term}&limit=${limit}&offset=${offset}" 2>/dev/null)
        [[ -n "$resp" ]] && out=$(__preprint_parse_hexagon "compact" "$base_url" <<< "$resp" 2>/dev/null)
        [[ -n "$out" ]] && echo "$out" || echo "No entries found in Hexagon Math."
    }

    # Stages a new work as a DRAFT on Hexagon Math
    __preprint_provider_hexagon_send() {
        local file="$PREPRINT_SEND_FILE" meta="$PREPRINT_SEND_META" title="$PREPRINT_SEND_TITLE"
        local author="$PREPRINT_SEND_AUTHOR" abstract="$PREPRINT_SEND_ABSTRACT"
        local category="${PREPRINT_SEND_CATEGORY:-math.GM}"
        local doi="$PREPRINT_SEND_DOI" journal="$PREPRINT_SEND_JOURNAL" pub_date="$PREPRINT_SEND_DATE"

        local base_url token user pass orcid
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        user="${HEXAGON_USER:-$(__preprint_get_conf hexagon user)}"
        pass="${HEXAGON_PASS:-$(__preprint_get_conf hexagon pass)}"
        orcid="${HEXAGON_ORCID:-$(__preprint_get_conf hexagon orcid)}"
        [[ -z "$orcid" ]] && orcid="$(__preprint_get_conf orcid orcid)"

        local auth_args=()
        if [[ -n "$token" ]]; then
            auth_args=(-H "Authorization: Bearer $token")
        elif [[ -n "$user" && -n "$pass" ]]; then
            auth_args=(-u "${user}:${pass}")
        else
            __log "Hexagon Math credentials missing. Run: preprint database set -d hexagon --token <TOKEN>" -t error -l preprint
            return 1
        fi

        [[ -z "$title" ]] && title="$(basename "${file%.*}")"
        [[ -z "$author" ]] && author="${USER:-Anonymous}"
        [[ -z "$abstract" ]] && abstract="Preprint submitted via omni preprint tool."
        [[ -z "$pub_date" ]] && printf -v pub_date "%(%Y-%m-%d)T" -1

        local meta_json=""
        if __preprint_is_raw_payload_meta "$meta"; then
            meta_json=$(<"$meta")
        else
            local esc_title esc_abs esc_cat contribs_json="" ext_json=""
            esc_title=$(__preprint_json_escape "$title")
            esc_abs=$(__preprint_json_escape "$abstract")
            esc_cat=$(__preprint_json_escape "$category")

            local IFS=';' a idx=0
            for a in $author; do
                a="${a#"${a%%[![:space:]]*}"}"
                a="${a%"${a##*[![:space:]]}"}"
                [[ -z "$a" ]] && continue
                if (( idx == 0 )) && [[ -n "$orcid" ]]; then
                    contribs_json+="${contribs_json:+,}{\"name\":\"$(__preprint_json_escape "$a")\",\"orcid\":\"$(__preprint_json_escape "$orcid")\"}"
                else
                    contribs_json+="${contribs_json:+,}{\"name\":\"$(__preprint_json_escape "$a")\"}"
                fi
                ((idx++))
            done

            [[ -n "$doi" ]] && ext_json+=",\"doi\":\"$(__preprint_json_escape "$doi")\""
            [[ -n "${PREPRINT_SEND_EXT_IDS[arxiv]:-}" ]] && ext_json+=",\"arxiv_id\":\"$(__preprint_json_escape "${PREPRINT_SEND_EXT_IDS[arxiv]}")\""
            [[ -n "${PREPRINT_SEND_EXT_IDS[hal]:-}" ]] && ext_json+=",\"hal_id\":\"$(__preprint_json_escape "${PREPRINT_SEND_EXT_IDS[hal]}")\""
            [[ -n "$journal" ]] && ext_json+=",\"journal_ref\":\"$(__preprint_json_escape "$journal")\""
            [[ -n "$pub_date" ]] && ext_json+=",\"publication_date\":\"$(__preprint_json_escape "$pub_date")\""

            meta_json="{\"title\":\"${esc_title}\",\"abstract\":\"${esc_abs}\",\"primary_category\":\"${esc_cat}\",\"contributors\":[${contribs_json}],\"publish\":false,\"status\":\"draft\"${ext_json}}"
        fi

        __log "Staging draft '$file' on Hexagon Math (${base_url}/api/v1/works)..." -t info -l preprint
        local resp http_code
        resp=$(curl -sS -w "\n%{http_code}" -X POST "${auth_args[@]}" \
            -F "metadata=${meta_json};type=application/json" \
            -F "file=@${file}" \
            "${base_url}/api/v1/works" 2>&1)
        http_code="${resp##*$'\n'}"
        local body="${resp%$'\n'*}"

        if [[ "$http_code" =~ ^20[012]$ ]]; then
            local work_id
            work_id=$(__preprint_parse_hexagon "extract_id" "$base_url" <<< "$body")
            [[ -z "$work_id" ]] && work_id="draft_$(date +%s)"
            __preprint_draft_save "hexagon" "$work_id" "$pub_date" "$title" "${author//;/, }" "-" "-"
            __log "Hexagon Math draft staged (ID: $work_id). Run 'preprint publish $work_id -d hexagon' to publish." -t success -l preprint
            echo "$body"
        else
            __log "Hexagon Math draft upload failed (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi
    }

    # Publishes ONLY a staged draft on Hexagon Math
    __preprint_provider_hexagon_publish() {
        local id="${1#hexagon:}"
        [[ -z "$id" ]] && { __log "Draft ID required: preprint publish <id> -d hexagon" -t error -l preprint; return 1; }

        local base_url token user pass auth_args=()
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        user="${HEXAGON_USER:-$(__preprint_get_conf hexagon user)}"
        pass="${HEXAGON_PASS:-$(__preprint_get_conf hexagon pass)}"

        if [[ -n "$token" ]]; then
            auth_args=(-H "Authorization: Bearer $token")
        elif [[ -n "$user" && -n "$pass" ]]; then
            auth_args=(-u "${user}:${pass}")
        else
            __log "Hexagon Math credentials missing." -t error -l preprint
            return 1
        fi

        # Verify remote status is not already published
        local check_json remote_status
        check_json=$(curl -fsSL "${auth_args[@]}" -H "Accept: application/json" "${base_url}/api/v1/works/${id}" 2>/dev/null)
        if [[ -n "$check_json" ]]; then
            remote_status=$(__preprint_parse_hexagon "check_status" "$base_url" <<< "$check_json")
            if [[ "$remote_status" == "published" ]] && ! __preprint_draft_get "hexagon" "$id" >/dev/null 2>&1; then
                __log "Work 'hexagon:${id}' is already published on Hexagon Math." -t error -l preprint
                return 1
            fi
        fi

        __log "Publishing draft 'hexagon:${id}' on Hexagon Math..." -t info -l preprint
        local resp http_code
        resp=$(curl -sS -w "\n%{http_code}" -X POST "${auth_args[@]}" \
            -H "Content-Type: application/json" \
            -d '{"action":"publish","publish":true,"status":"published"}' \
            "${base_url}/api/v1/works/${id}/publish" 2>&1)
        http_code="${resp##*$'\n'}"
        local body="${resp%$'\n'*}"

        if [[ ! "$http_code" =~ ^20[0124]$ ]]; then
            # Fallback to PATCH /api/v1/works/<id> if /publish endpoint is not separate
            resp=$(curl -sS -w "\n%{http_code}" -X PATCH "${auth_args[@]}" \
                -H "Content-Type: application/json" \
                -d '{"publish":true,"status":"published"}' \
                "${base_url}/api/v1/works/${id}" 2>&1)
            http_code="${resp##*$'\n'}"
            body="${resp%$'\n'*}"
        fi

        if [[ "$http_code" =~ ^20[0124]$ ]]; then
            __log "Published 'hexagon:${id}' on Hexagon Math (${base_url}/${id})!" -t success -l preprint
            return 0
        else
            __log "Failed to publish 'hexagon:${id}' on Hexagon Math (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi
    }

    __preprint_provider_hexagon_rm() {
        local id="${1#hexagon:}"
        [[ -z "$id" ]] && { __log "Work ID required to remove from Hexagon Math." -t error -l preprint; return 1; }
        local base_url token user pass auth_args=()
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        user="${HEXAGON_USER:-$(__preprint_get_conf hexagon user)}"
        pass="${HEXAGON_PASS:-$(__preprint_get_conf hexagon pass)}"

        if [[ -n "$token" ]]; then
            auth_args=(-H "Authorization: Bearer $token")
        elif [[ -n "$user" && -n "$pass" ]]; then
            auth_args=(-u "${user}:${pass}")
        else
            __log "Hexagon Math credentials required to delete works." -t error -l preprint
            return 1
        fi

        local resp http_code
        resp=$(curl -sS -w "\n%{http_code}" -X DELETE "${auth_args[@]}" "${base_url}/api/v1/works/${id}" 2>&1)
        http_code="${resp##*$'\n'}"
        if [[ "$http_code" =~ ^20[024]$ ]]; then
            __log "Removed 'hexagon:${id}' from Hexagon Math." -t success -l preprint
        else
            __log "Failed to remove 'hexagon:${id}' (HTTP $http_code)." -t error -l preprint
            return 1
        fi
    }
}
