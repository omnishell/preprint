#! /bin/bash

__hexagon__() {
    __preprint_register_provider "hexagon" \
        --aliases "hexagonmath,hexagon-math,hexagon math" \
        --pagination "offset" \
        --requires-file "true" \
        --requires-category "true" \
        --desc "Hexagon Math preprint server (OpenAPI v1.13: TeX/ZIP staging, revisions & commit)"

    __preprint_hexagon_base_url() {
        local sb
        sb="$(__preprint_get_conf hexagon sandbox)"
        if [[ "$sb" == "true" || "${HEXAGON_SANDBOX:-0}" == "1" ]]; then
            echo "${HEXAGON_API_URL:-https://sandbox.hexagonmath.org}"
        else
            echo "${HEXAGON_API_URL:-https://hexagonmath.org}"
        fi
    }

    __preprint_hexagon_validate_subject() {
        local c="${1:-}"
        case "$c" in
            math.AC|math.AG|math.AP|math.AT|math.CA|math.CO|math.CT|math.CV|math.DG|math.DS|math.FA|math.GM|math.GN|math.GR|math.GT|math.HO|math.IT|math.KT|math.LO|math.MG|math.MP|math.NA|math.NT|math.OA|math.OC|math.PR|math.QA|math.RA|math.RT|math.SG|math.SP|math.ST|cs.AI|cs.CC|cs.CG|cs.DM|cs.DS|cs.FL|cs.IT|cs.LO|cs.MS|cs.NA|cs.SC|math-ph|quant-ph|stat.TH)
                return 0
                ;;
            *)
                return 1
                ;;
        esac
    }

    __preprint_hexagon_default_msc() {
        local subj="$1"
        case "$subj" in
            math-ph|math.MP) echo "81T13" ;;
            quant-ph)        echo "81P15" ;;
            math.DG)         echo "53C07" ;;
            math.NT)         echo "11F03" ;;
            math.AG)         echo "14A10" ;;
            math.SP)         echo "58J50" ;;
            math.AP)         echo "35Q40" ;;
            math.FA)         echo "46L05" ;;
            math.QA)         echo "17B37" ;;
            math.RT)         echo "22E46" ;;
            math.GT)         echo "57M50" ;;
            math.AT)         echo "55N20" ;;
            math.CO)         echo "05A15" ;;
            math.PR)         echo "60B20" ;;
            math.LO|cs.LO)   echo "03B10" ;;
            math.CT)         echo "18B25" ;;
            cs.AI)           echo "68T01" ;;
            *)               echo "00A05" ;;
        esac
    }

    __preprint_parse_hexagon() {
        local mode="${1:-compact}" base_url="${2:-https://hexagonmath.org}" filter_orcid="${3:-}" filter_author="${4:-}"
        LC_ALL=C awk -v mode="$mode" -v base_url="$base_url" -v filter_orcid="$filter_orcid" -v filter_author="$filter_author" '
            function unesc_json(s) {
                gsub(/\\"/, "\"", s); gsub(/\\\\/, "\\", s)
                gsub(/\\n/, " ", s); gsub(/\\r/, "", s); gsub(/\\t/, " ", s)
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s)
                return s
            }
            function get_json_str(chunk, key,    pat, s) {
                pat = "\"" key "\"[ \t]*:[ \t]*\""
                if (match(chunk, pat "(\\\\.|[^\"\\\\])*\"")) {
                    s = substr(chunk, RSTART, RLENGTH)
                    sub("^" pat, "", s); sub(/"$/, "", s)
                    return unesc_json(s)
                }
                return ""
            }
            function get_json_num(chunk, key,    pat, s) {
                pat = "\"" key "\"[ \t]*:[ \t]*[0-9]+"
                if (match(chunk, pat)) {
                    s = substr(chunk, RSTART, RLENGTH)
                    sub("^.*:[ \t]*", "", s)
                    return s
                }
                return ""
            }
            function get_json_str_array(chunk, key, sep,    pat, s, m, out) {
                out = ""
                pat = "\"" key "\"[ \t]*:[ \t]*\\[[^\\]]*\\]"
                if (match(chunk, pat)) {
                    s = substr(chunk, RSTART, RLENGTH)
                    sub("^" "\"" key "\"[ \t]*:[ \t]*\\[", "", s)
                    sub(/\]$/, "", s)
                    while (match(s, /"(\\.|[^"\\])*"/)) {
                        m = substr(s, RSTART + 1, RLENGTH - 2)
                        s = substr(s, RSTART + RLENGTH)
                        m = unesc_json(m)
                        if (m != "") out = (out == "" ? m : out sep m)
                    }
                }
                return out
            }
            function unpack_metadata_json(chunk,    mjson) {
                if (chunk ~ /"metadataJson"[ \t]*:[ \t]*"\{/) {
                    mjson = get_json_str(chunk, "metadataJson")
                    if (mjson != "") return chunk "\n" mjson
                }
                return chunk
            }
            function is_json_draft(chunk,    st) {
                st = tolower(get_json_str(chunk, "status"))
                if (st == "") st = tolower(get_json_str(chunk, "state"))
                if (st == "published" || st == "accepted" || st == "live") return 0
                if (st == "draft" || st == "uploading" || st == "unpublished" || st == "staged" || st == "in_progress" || st == "pending" || st == "submitted") return 1
                if (chunk ~ /"draftId"[ \t]*:/ || chunk ~ /"metadataJson"[ \t]*:/) return 1
                if (chunk ~ /"(published|is_published)"[ \t]*:[ \t]*false/) return 1
                return 0
            }
            function norm_date(d, id) {
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", d)
                if (match(d, /20[0-9]{2}-[0-9]{2}-[0-9]{2}/)) return substr(d, RSTART, 10)
                if (id ~ /^[0-9]{4}\./) return "20" substr(id, 1, 2) "-" substr(id, 3, 2)
                return "N/A"
            }
            function get_json_date(chunk, id,    d, keys, n, i) {
                n = split("publishedAt,published_at,publication_date,submittedAt,submitted_at,submission_date,released_at,versionCreatedAt,createdAt,created_at,updated_at,date", keys, ",")
                for (i = 1; i <= n; i++) {
                    d = get_json_str(chunk, keys[i])
                    if (d != "") return norm_date(d, id)
                }
                if (match(chunk, /"20[0-9]{2}-[0-9]{2}-[0-9]{2}([T ][0-9:.+-Z]+)?"/)) {
                    return substr(chunk, RSTART + 1, 10)
                }
                return norm_date("", id)
            }
            function get_json_authors(chunk,    s, out, pat, m, depth, i, c, in_str, esc, arr_start) {
                out = ""
                if (match(chunk, /"(contributors|authors|creators)"[ \t]*:[ \t]*\[/)) {
                    arr_start = RSTART + RLENGTH - 1
                    depth = 0; in_str = 0; esc = 0
                    for (i = arr_start; i <= length(chunk); i++) {
                        c = substr(chunk, i, 1)
                        if (in_str) {
                            if (esc) esc = 0
                            else if (c == "\\") esc = 1
                            else if (c == "\"") in_str = 0
                            continue
                        }
                        if (c == "\"") { in_str = 1; continue }
                        if (c == "[") depth++
                        else if (c == "]") {
                            depth--
                            if (depth == 0) {
                                s = substr(chunk, arr_start, i - arr_start + 1)
                                break
                            }
                        }
                    }
                    pat = "\"(name|full_name|display_name|author_name|credit_name)\"[ \t]*:[ \t]*\"(\\\\.|[^\"\\\\])*\""
                    while (match(s, pat)) {
                        m = substr(s, RSTART, RLENGTH)
                        s = substr(s, RSTART + RLENGTH)
                        sub(/^"[^"]+"[ \t]*:[ \t]*"/, "", m); sub(/"$/, "", m)
                        m = unesc_json(m)
                        if (m != "") out = (out == "" ? m : out ", " m)
                    }
                }
                if (out == "") out = get_json_str(chunk, "authors_text")
                if (out == "") out = get_json_str(chunk, "author")
                if (out == "") out = get_json_str(chunk, "sponsorName")
                return out
            }
            function chunk_has_orcid(chunk, target_orcid,    s, m, val, norm_target) {
                norm_target = tolower(target_orcid)
                sub(/^https?:\/\/orcid\.org\//, "", norm_target)
                gsub(/^[ \t]+|[ \t]+$/, "", norm_target)
                if (norm_target == "") return 0

                s = chunk
                while (match(s, /"orcid"[ \t]*:[ \t]*"[^"]*"/)) {
                    m = substr(s, RSTART, RLENGTH)
                    s = substr(s, RSTART + RLENGTH)
                    sub(/^"orcid"[ \t]*:[ \t]*"/, "", m)
                    sub(/"$/, "", m)
                    val = tolower(unesc_json(m))
                    sub(/^https?:\/\/orcid\.org\//, "", val)
                    gsub(/^[ \t]+|[ \t]+$/, "", val)
                    if (val == norm_target) return 1
                }
                return 0
            }
            function pick_best_id(chunk,    id, ver, s, m, best, base) {
                id = get_json_str(chunk, "identifier")
                ver = get_json_num(chunk, "versionNumber")
                if (id != "") {
                    sub(/^hexagon:/, "", id)
                    if (ver != "" && id !~ /v[0-9]+$/) id = id "v" ver
                    return id
                }
                s = chunk; best = ""
                while (match(s, /(hexagon:)?[0-9]{4}\.[0-9]{4,5}(v[0-9]+)?/)) {
                    m = substr(s, RSTART, RLENGTH)
                    sub(/^hexagon:/, "", m)
                    s = substr(s, RSTART + RLENGTH)
                    if (best == "") best = m
                    else {
                        base = best; sub(/v[0-9]+$/, "", base)
                        if (m ~ ("^" base "v[0-9]+$") && best !~ /v[0-9]+$/) best = m
                    }
                }
                if (best == "") best = get_json_str(chunk, "draftId")
                if (best == "") best = get_json_str(chunk, "id")
                sub(/^hexagon:/, "", best)
                if (best != "" && ver != "" && best ~ /^[0-9]{4}\.[0-9]{4,5}$/) best = best "v" ver
                return best
            }
            function extract_works_objects(src, objs,    arr_idx, len, i, c, in_str, esc, arr_depth, obj_depth, start_pos, n) {
                arr_idx = 0
                if (match(src, /"(works|items|results|submissions|data)"[ \t]*:[ \t]*\[/)) {
                    arr_idx = RSTART + RLENGTH - 1
                } else if (match(src, /^[ \t\r\n]*\[/)) {
                    arr_idx = RSTART + RLENGTH - 1
                }
                if (arr_idx == 0) return 0

                len = length(src)
                in_str = 0; esc = 0; arr_depth = 0; obj_depth = 0; start_pos = 0; n = 0
                for (i = arr_idx; i <= len; i++) {
                    c = substr(src, i, 1)
                    if (in_str) {
                        if (esc) { esc = 0 }
                        else if (c == "\\") { esc = 1 }
                        else if (c == "\"") { in_str = 0 }
                        continue
                    }
                    if (c == "\"") { in_str = 1; continue }
                    if (c == "[") {
                        arr_depth++
                    } else if (c == "]") {
                        arr_depth--
                        if (arr_depth <= 0) break
                    } else if (c == "{") {
                        if (arr_depth == 1 && obj_depth == 0) start_pos = i
                        obj_depth++
                    } else if (c == "}") {
                        if (obj_depth > 0) obj_depth--
                        if (arr_depth == 1 && obj_depth == 0 && start_pos > 0) {
                            objs[++n] = substr(src, start_pos, i - start_pos + 1)
                            start_pos = 0
                        }
                    }
                }
                return n
            }
            function matches_profile(chunk, authors,    sponsor, hay, needle) {
                if (filter_orcid != "") {
                    return chunk_has_orcid(chunk, filter_orcid)
                }
                if (filter_author != "") {
                    sponsor = get_json_str(chunk, "sponsorName")
                    hay = tolower(authors "\n" sponsor)
                    needle = tolower(filter_author)
                    gsub(/^[ \t]+|[ \t]+$/, "", needle)
                    return (needle != "" && index(hay, needle) > 0)
                }
                return 1
            }
            { raw = raw $0 "\n" }
            END {
                if (mode == "extract_draft_id") {
                    id = get_json_str(raw, "draftId")
                    if (id == "") id = get_json_str(raw, "id")
                    if (id == "") id = pick_best_id(raw)
                    if (id != "") print id
                    exit 0
                }
                if (mode == "extract_upload_id") {
                    id = get_json_str(raw, "uploadId")
                    if (id == "") id = get_json_str(raw, "id")
                    if (id == "") id = get_json_str(raw, "existingUploadId")
                    if (id != "") print id
                    exit 0
                }
                if (mode == "extract_entry_tex") {
                    if (match(raw, /"[^"]+\.tex"/)) {
                        s = substr(raw, RSTART + 1, RLENGTH - 2)
                        print unesc_json(s)
                    }
                    exit 0
                }
                if (raw ~ /^[ \t\r\n]*[\{\[]/) {
                    if (mode == "detailed") {
                        raw = unpack_metadata_json(raw)
                        id = pick_best_id(raw)
                        if (id == "") exit 1
                        title = get_json_str(raw, "title")
                        if (title == "") exit 1
                        pub = get_json_date(raw, id)
                        authors = get_json_authors(raw); if (authors == "") authors = "Unknown Contributor"
                        cat = get_json_str(raw, "subject")
                        if (cat == "") cat = get_json_str(raw, "primary_category")
                        if (cat == "") cat = "N/A"
                        msc = get_json_str_array(raw, "mscCodes", ", ")
                        if (msc == "") msc = "N/A"
                        tags = get_json_str_array(raw, "tags", "; ")
                        if (tags == "") tags = "N/A"
                        pages = get_json_num(raw, "pageCount"); if (pages == "") pages = "N/A"
                        comments = get_json_str(raw, "comments"); if (comments == "") comments = "-"
                        abs = get_json_str(raw, "abstract"); if (abs == "") abs = get_json_str(raw, "summary")
                        st = (is_json_draft(raw) ? "DRAFT" : "PUBLISHED")
                        if (st == "DRAFT") {
                            printf "DraftId:   %s\nStatus:    %s\nTitle:     %s\nCreated:   %s\nAuthors:   %s\nSubject:   %s\nMSC:       %s\nKeywords:  %s\nComments:  %s\nPreview:   %s/api/v1/submissions/%s/preview/pdf\nAbstract:\n  %s\n", id, st, title, pub, authors, cat, msc, tags, comments, base_url, id, abs
                        } else {
                            printf "ID:        hexagon:%s\nStatus:    %s\nTitle:     %s\nPublished: %s\nAuthors:   %s\nSubject:   %s\nMSC:       %s\nKeywords:  %s\nComments:  %s\nPages:     %s\nURL:       %s/abs/%s\nPDF:       %s/pdf/%s\nSource:    %s/src/%s\nAbstract:\n  %s\n", id, st, title, pub, authors, cat, msc, tags, comments, pages, base_url, id, base_url, id, base_url, id, abs
                        }
                        exit 0
                    }

                    n = extract_works_objects(raw, items)
                    if (n == 0 && raw ~ /^[ \t\r\n]*\{/ && raw !~ /"works"[ \t]*:[ \t]*\[/) {
                        items[1] = raw
                        n = 1
                    }

                    if (mode == "page") {
                        nc = get_json_str(raw, "nextCursor")
                        if (nc == "") nc = get_json_str(raw, "next_cursor")
                        if (nc == "null") nc = ""
                        printf "__PAGE_META__\t%d\t%s\n", n, nc
                    }

                    count = 0
                    for (i = 1; i <= n; i++) {
                        chunk = unpack_metadata_json(items[i])
                        id = pick_best_id(chunk)
                        if (id == "") continue
                        base_id = id; sub(/v[0-9]+$/, "", base_id)
                        if (base_id in seen) continue
                        title = get_json_str(chunk, "title")
                        if (title == "") continue
                        authors = get_json_authors(chunk)
                        if (authors == "") authors = "Unknown Contributor"
                        if (!matches_profile(chunk, authors)) continue
                        seen[base_id] = 1
                        pub = get_json_date(chunk, id)
                        badge = (is_json_draft(chunk) ? "[DRAFT] " : "[PUBLISHED] ")
                        printf "[%s] (%s) %s%s   %s\n", id, pub, badge, title, authors
                        count++
                    }
                    if (mode != "page" && count == 0) exit 1
                    exit 0
                }
                exit 1
            }
        '
    }

    __preprint_provider_hexagon_download() {
        local id="$1" out_path="${2:-}"
        local clean_id="${id#hexagon:}"
        clean_id="${clean_id%.pdf}"
        local base_url="$(__preprint_hexagon_base_url)"

        if __preprint_draft_get "hexagon" "$clean_id" >/dev/null 2>&1 || [[ ! "$clean_id" =~ ^[0-9]{4}\.[0-9]{5} ]]; then
            local token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
            if [[ -n "$token" ]]; then
                curl -sS -X POST -H "Authorization: Bearer $token" "${base_url}/api/v1/submissions/${clean_id}/preview" >/dev/null 2>&1 || true
                local preview_url="${base_url}/api/v1/submissions/${clean_id}/preview/pdf"
                local dest="hexagon_draft_${clean_id}.pdf"
                [[ -n "$out_path" ]] && { [[ -d "$out_path" ]] && dest="${out_path%/}/$dest" || dest="$out_path"; }
                if curl -fL -H "Authorization: Bearer $token" "$preview_url" -o "$dest" 2>/dev/null && [[ -s "$dest" ]]; then
                    __log "Saved draft preview PDF to '$dest'." -t success -l preprint
                    return 0
                else
                    rm -f "$dest" 2>/dev/null
                    __log "Draft '$clean_id' does not have a compiled preview PDF yet (preview queued on Hexagon)." -t warning -l preprint
                    return 1
                fi
            fi
        fi

        local pdf_url="${base_url}/pdf/${clean_id}"
        __preprint_save_pdf_stream "$pdf_url" "hexagon_${clean_id//\//_}.pdf" "$out_path" "${pdf_url}.pdf"
    }

    __preprint_hexagon_orcid_surname() {
        local orcid="$1"
        local cache_dir="${XDG_DATA_HOME:-$HOME/.local/share}/omni/preprint/cache"
        mkdir -p "$cache_dir"
        local name_cache="${cache_dir}/orcid_${orcid//[^a-zA-Z0-9_-]/_}.name"
        if [[ -s "$name_cache" ]]; then
            cat "$name_cache"
            return 0
        fi

        local fam=""
        fam=$(curl -fsSL --max-time 5 -H "Accept: application/vnd.orcid+xml" "https://pub.orcid.org/v3.0/${orcid}/person" 2>/dev/null | LC_ALL=C awk '
            function strip_tag(s) { gsub(/<[^>]+>/, "", s); gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s); return s }
            /<personal-details:family-names[^>]*>/ { fn = strip_tag($0) }
            /<personal-details:credit-name[^>]*>/  { cn = strip_tag($0) }
            END {
                if (fn != "") print fn
                else if (cn != "") print cn
            }
        ')

        if [[ -z "$fam" ]]; then
            fam=$(curl -fsSL --max-time 5 "https://api.openalex.org/authors/https://orcid.org/${orcid}" 2>/dev/null | LC_ALL=C awk '
                match($0, /"display_name"[ \t]*:[ \t]*"[^"]+"/) {
                    s = substr($0, RSTART, RLENGTH)
                    sub(/^"display_name"[ \t]*:[ \t]*"/, "", s); sub(/"$/, "", s)
                    n = split(s, parts, " ")
                    if (n > 0) print parts[n]
                    exit
                }
            ')
        fi

        if [[ -n "$fam" ]]; then
            local last_word="${fam##* }"
            [[ -z "$last_word" ]] && last_word="$fam"
            printf '%s\n' "$last_word" > "$name_cache"
            echo "$last_word"
        fi
    }

    __preprint_hexagon_fetch_works_cursor() {
        local base_url="$1" query_params="$2" filter_orcid="$3" filter_author="$4" max_pages="${5:-20}"
        local page_limit=100 cursor="" prev_cursor="" page=0 resp parsed meta_line raw_count=0 page_out all_out=""

        while (( page < max_pages )); do
            local url="${base_url}/api/v1/works?limit=${page_limit}"
            [[ -n "$query_params" ]] && url+="&${query_params}"
            [[ -n "$cursor" ]] && url+="&cursor=$(__preprint_urlencode "$cursor")"

            resp=$(curl -fsSL -H "Accept: application/json" "$url" 2>/dev/null)
            [[ -z "$resp" ]] && break

            parsed=$(__preprint_parse_hexagon "page" "$base_url" "$filter_orcid" "$filter_author" <<< "$resp" 2>/dev/null)
            [[ -z "$parsed" ]] && break

            meta_line="${parsed%%$'\n'*}"
            if [[ "$parsed" == *$'\n'* ]]; then
                page_out="${parsed#*$'\n'}"
            else
                page_out=""
            fi

            [[ -n "$page_out" ]] && all_out="${all_out:+$all_out$'\n'}${page_out}"

            raw_count=0
            prev_cursor="$cursor"
            cursor=""
            if [[ "$meta_line" == __PAGE_META__$'\t'* ]]; then
                local rest="${meta_line#*$'\t'}"
                raw_count="${rest%%$'\t'*}"
                cursor="${rest#*$'\t'}"
            fi

            if (( raw_count < page_limit )); then
                break
            fi
            [[ -z "$cursor" || "$cursor" == "$prev_cursor" ]] && break
            ((page++))
        done

        [[ -n "$all_out" ]] && printf '%s\n' "$all_out" | LC_ALL=C awk '!seen[$0]++'
    }

    __preprint_provider_hexagon_list() {
        local max="${1:-0}" sort_by="${2:-time}" reverse="${3:-0}"
        local base_url profile orcid
        base_url="$(__preprint_hexagon_base_url)"
        profile="${HEXAGON_PROFILE:-$(__preprint_get_conf hexagon profile)}"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf hexagon author)"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf hexagon user)"
        orcid="${HEXAGON_ORCID:-$(__preprint_get_conf hexagon orcid)}"
        [[ -z "$orcid" ]] && orcid="$(__preprint_get_conf orcid orcid)"

        local out=""

        if [[ -n "$orcid" ]]; then
            local orcid_family="${profile:-$(__preprint_hexagon_orcid_surname "$orcid")}"
            if [[ -n "$orcid_family" ]]; then
                local enc_fam=$(__preprint_urlencode "${orcid_family:0:45}")
                out=$(__preprint_hexagon_fetch_works_cursor "$base_url" "author=${enc_fam}" "$orcid" "" 5)
            fi
            if [[ -z "$out" ]]; then
                out=$(__preprint_hexagon_fetch_works_cursor "$base_url" "" "$orcid" "" 20)
            fi
        elif [[ -n "$profile" ]]; then
            local enc_prof=$(__preprint_urlencode "${profile:0:45}")
            out=$(__preprint_hexagon_fetch_works_cursor "$base_url" "author=${enc_prof}" "" "$profile" 5)
            if [[ -z "$out" ]]; then
                out=$(__preprint_hexagon_fetch_works_cursor "$base_url" "sponsor=${enc_prof}" "" "$profile" 5)
            fi
        fi

        if [[ -n "$out" ]]; then
            (( max > 0 )) && head -n "$max" <<< "$out" || echo "$out"
            return 0
        fi
        echo "No entries found in Hexagon Math."
    }

    __preprint_provider_hexagon_get() {
        local id="${1#hexagon:}"
        local base_url token
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"

        local resp
        if [[ "$id" =~ ^[0-9]{4}\.[0-9]{5}(v[1-9][0-9]*)?$ ]]; then
            resp=$(curl -fsSL -H "Accept: application/json" "${base_url}/api/v1/works/${id}" 2>/dev/null)
            if [[ -n "$resp" ]] && __preprint_parse_hexagon "detailed" "$base_url" <<< "$resp" 2>/dev/null; then
                return 0
            fi
        fi

        if [[ -n "$token" ]]; then
            resp=$(curl -fsSL -H "Authorization: Bearer $token" -H "Accept: application/json" "${base_url}/api/v1/submissions/${id}" 2>/dev/null)
            if [[ -n "$resp" ]] && __preprint_parse_hexagon "detailed" "$base_url" <<< "$resp" 2>/dev/null; then
                return 0
            fi
        fi

        local draft_row
        if draft_row="$(__preprint_draft_get "hexagon" "$id" 2>/dev/null)"; then
            local _ d_id d_date d_title d_authors _ d_extra d_subj d_fn
            IFS=$'\t' read -r _ d_id d_date d_title d_authors _ d_extra <<< "$draft_row"
            d_subj="${d_extra%%|*}"
            d_fn="${d_extra#*|}"
            printf "DraftId:   %s\nStatus:    DRAFT\nTitle:     %s\nCreated:   %s\nAuthors:   %s\nSubject:   %s\nFile:      %s\nPreview:   %s/api/v1/submissions/%s/preview/pdf\n" \
                "$d_id" "$d_title" "$d_date" "$d_authors" "${d_subj:-N/A}" "${d_fn:--}" "$base_url" "$d_id"
            return 0
        fi

        __log "No entry found in Hexagon Math for '$id'." -t error -l preprint
        return 1
    }

    __preprint_provider_hexagon_search() {
        local term="$1" limit="${2:-50}" offset="${3:-0}" sort_by="${4:-time}" reverse="${5:-0}"
        local base_url="$(__preprint_hexagon_base_url)"
        (( limit > 100 )) && limit=100
        local short_term="${term:0:45}"
        local enc_term=$(__preprint_urlencode "$short_term")
        local resp out=""

        resp=$(curl -fsSL -H "Accept: application/json" "${base_url}/api/v1/works?q=${enc_term}&limit=${limit}" 2>/dev/null)
        [[ -n "$resp" ]] && out=$(__preprint_parse_hexagon "compact" "$base_url" "" "" <<< "$resp" 2>/dev/null)

        if [[ -z "$out" ]]; then
            local atom_order="descending"
            (( reverse == 1 )) && atom_order="ascending"
            resp=$(curl -fsSL "${base_url}/api/query?search_query=all:${enc_term}&start=${offset}&max_results=${limit}&sortBy=submittedDate&sortOrder=${atom_order}" 2>/dev/null)
            if [[ -n "$resp" && "$resp" == *"<entry>"* ]]; then
                out=$(__preprint_parse_arxiv_atom "compact" <<< "$resp" 2>/dev/null)
            fi
        fi

        [[ -n "$out" ]] && echo "$out" || echo "No entries found in Hexagon Math."
    }

    # Shared upload + metadata staging engine for both 'send' (new) and 'update' (new version)
    __preprint_hexagon_stage_deposit() {
        local revise_target="${1:-}"
        local file="$PREPRINT_SEND_FILE" meta="$PREPRINT_SEND_META" title="$PREPRINT_SEND_TITLE"
        local author="$PREPRINT_SEND_AUTHOR" abstract="$PREPRINT_SEND_ABSTRACT"
        local category="$PREPRINT_SEND_CATEGORY" pub_date="$PREPRINT_SEND_DATE"
        local msc_raw="${PREPRINT_SEND_MSC:-}" kw_raw="${PREPRINT_SEND_KEYWORDS:-}"
        local comments="${PREPRINT_SEND_COMMENTS:-}"
        local arxiv_id="${PREPRINT_SEND_EXT_IDS[arxiv]:-}"

        if [[ -n "$category" ]] && ! __preprint_hexagon_validate_subject "$category"; then
            __log "Invalid Hexagon Math category '$category'. Allowed primary subjects:
  math.AC, math.AG, math.AP, math.AT, math.CA, math.CO, math.CT, math.CV, math.DG, math.DS,
  math.FA, math.GM, math.GN, math.GR, math.GT, math.HO, math.IT, math.KT, math.LO, math.MG,
  math.MP, math.NA, math.NT, math.OA, math.OC, math.PR, math.QA, math.RA, math.RT, math.SG,
  math.SP, math.ST, cs.AI, cs.CC, cs.CG, cs.DM, cs.DS, cs.FL, cs.IT, cs.LO, cs.MS, cs.NA,
  cs.SC, math-ph, quant-ph, stat.TH" -t error -l preprint
            return 1
        fi

        local base_url token sponsor
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        sponsor="${HEXAGON_PROFILE:-$(__preprint_get_conf hexagon profile)}"
        [[ -z "$sponsor" ]] && sponsor="${HEXAGON_USER:-$(__preprint_get_conf hexagon user)}"

        if [[ -z "$token" ]]; then
            __log "Hexagon Math submission bearer token missing. Run: preprint db set hexagon --token <TOKEN>" -t error -l preprint
            return 1
        fi

        local tmp_zip="" upload_target="$file" upload_kind="source" content_type="text/x-tex"
        if [[ -d "$file" ]]; then
            tmp_zip="$(mktemp -u "${TMPDIR:-/tmp}/hexagon_src_XXXXXX.zip")"
            (cd "$file" && zip -qr "$tmp_zip" . -x "*.git*" "*.pdf" "*.aux" "*.log" "*.out")
            upload_target="$tmp_zip"
            upload_kind="source-archive"
            content_type="application/zip"
        elif [[ "$file" == *.zip ]]; then
            upload_kind="source-archive"
            content_type="application/zip"
        elif [[ "$file" == *.tex ]]; then
            upload_kind="source"
            content_type="text/x-tex"
        else
            __log "Hexagon Math requires a .tex source file, source directory, or .zip source archive (got '$file')." -t error -l preprint
            return 1
        fi

        [[ -z "$sponsor" ]] && sponsor="${author%%;*}"
        [[ -z "$pub_date" ]] && printf -v pub_date "%(%Y-%m-%d)T" -1

        local subject="$category"
        local msc_json_arr=""
        if [[ -n "$msc_raw" ]]; then
            while IFS= read -r mc; do
                [[ -z "$mc" ]] && continue
                msc_json_arr+="${msc_json_arr:+,}\"$(__preprint_json_escape "$mc")\""
            done < <(LC_ALL=C awk '
                {
                    s = $0; count = 0
                    while (match(s, /[0-9]{2}([A-Z][0-9]{2}|-[0-9]{2})/)) {
                        c = substr(s, RSTART, RLENGTH)
                        s = substr(s, RSTART + RLENGTH)
                        if (!(c in seen)) { seen[c] = 1; print c; if (++count >= 5) exit }
                    }
                }
            ' <<< "$msc_raw")
        fi
        if [[ -z "$msc_json_arr" ]]; then
            local default_msc="$(__preprint_hexagon_default_msc "$subject")"
            msc_json_arr="\"$(__preprint_json_escape "$default_msc")\""
        fi

        local tags_field=""
        if [[ -n "$kw_raw" ]]; then
            local tags_json_arr=""
            local IFS=';' kw
            for kw in $kw_raw; do
                kw="${kw#"${kw%%[![:space:]]*}"}"
                kw="${kw%"${kw##*[![:space:].]}"}"
                [[ -z "$kw" ]] && continue
                tags_json_arr+="${tags_json_arr:+,}\"$(__preprint_json_escape "${kw:0:80}")\""
            done
            [[ -n "$tags_json_arr" ]] && tags_field=",\"tags\":[${tags_json_arr}]"
        fi

        local comments_field=""
        [[ -n "$comments" ]] && comments_field=",\"comments\":\"$(__preprint_json_escape "${comments:0:2000}")\""

        local meta_json=""
        if __preprint_is_raw_payload_meta "$meta"; then
            meta_json=$(<"$meta")
        else
            local esc_title esc_abs esc_subj esc_sponsor authors_json="" arxiv_field=""
            esc_title=$(__preprint_json_escape "${title:0:240}")
            esc_abs=$(__preprint_json_escape "${abstract:0:8000}")
            esc_subj=$(__preprint_json_escape "$subject")
            esc_sponsor=$(__preprint_json_escape "${sponsor:0:180}")

            local IFS=';' a
            for a in $author; do
                a="${a#"${a%%[![:space:]]*}"}"
                a="${a%"${a##*[![:space:]]}"}"
                [[ -z "$a" ]] && continue
                authors_json+="${authors_json:+,}{\"name\":\"$(__preprint_json_escape "$a")\"}"
            done
            [[ -z "$revise_target" && -n "$arxiv_id" ]] && arxiv_field=",\"arxivId\":\"$(__preprint_json_escape "$arxiv_id")\""

            meta_json="{\"title\":\"${esc_title}\",\"abstract\":\"${esc_abs}\"${comments_field},\"subject\":\"${esc_subj}\",\"mscCodes\":[${msc_json_arr}]${tags_field},\"authorshipMode\":\"human\",\"authors\":[${authors_json}],\"submittingContributorIndex\":0,\"sponsorName\":\"${esc_sponsor}\",\"humanUnderstanding\":\"all\",\"correctnessConfirmed\":true,\"communityInterestConfirmed\":true,\"citationsConfirmed\":true,\"license\":\"CC BY 4.0\",\"rightsConfirmed\":true${arxiv_field}}"
        fi

        local fname="$(basename "$upload_target")"
        local resp http_code body draft_id=""

        # A. REVISION FLOW ('preprint paper update' / 'preprint paper send -u <id>')
        if [[ -n "$revise_target" ]]; then
            local clean_rev="${revise_target#hexagon:}"
            # Strip trailing vN if it's a published identifier like 2611.00532v1
            if [[ "$clean_rev" =~ ^([0-9]{4}\.[0-9]{4,5})v[0-9]+$ ]]; then
                clean_rev="${BASH_REMATCH[1]}"
            fi

            __log "Step 1/4: Opening revision draft for '$clean_rev' (${base_url}/api/v1/submissions/${clean_rev}/revise)..." -t info -l preprint
            resp=$(curl -sS -w "\n%{http_code}" -X POST \
                -H "Authorization: Bearer $token" \
                -H "Accept: application/json" \
                "${base_url}/api/v1/submissions/${clean_rev}/revise" 2>&1)
            http_code="${resp##*$'\n'}"
            body="${resp%$'\n'*}"

            if [[ "$http_code" == "409" ]]; then
                # If it was an unpublished committed package, pause for corrections first, then revise
                curl -sS -X POST -H "Authorization: Bearer $token" "${base_url}/api/v1/submissions/${clean_rev}/corrections" >/dev/null 2>&1 || true
                resp=$(curl -sS -w "\n%{http_code}" -X POST \
                    -H "Authorization: Bearer $token" \
                    -H "Accept: application/json" \
                    "${base_url}/api/v1/submissions/${clean_rev}/revise" 2>&1)
                http_code="${resp##*$'\n'}"
                body="${resp%$'\n'*}"
            fi

            if [[ "$http_code" =~ ^20[01]$ ]]; then
                draft_id=$(__preprint_parse_hexagon "extract_draft_id" "$base_url" <<< "$body")
                [[ -z "$draft_id" ]] && draft_id="$clean_rev"
            elif __preprint_draft_get "hexagon" "$clean_rev" >/dev/null 2>&1; then
                draft_id="$clean_rev"
            else
                [[ -n "$tmp_zip" ]] && rm -f "$tmp_zip"
                __log "Failed to open revision draft for '$clean_rev' on Hexagon (HTTP $http_code)." -t error -l preprint
                echo "$body" >&2
                return 1
            fi

            __log "Updating metadata on revision draft '$draft_id'..." -t info -l preprint
            resp=$(curl -sS -w "\n%{http_code}" -X PATCH \
                -H "Authorization: Bearer $token" \
                -H "Content-Type: application/json" \
                -d "$meta_json" \
                "${base_url}/api/v1/submissions/${draft_id}" 2>&1)
            http_code="${resp##*$'\n'}"
            body="${resp%$'\n'*}"
            if [[ "$http_code" != "200" ]]; then
                [[ -n "$tmp_zip" ]] && rm -f "$tmp_zip"
                __log "Failed updating metadata on revision draft '$draft_id' (HTTP $http_code)." -t error -l preprint
                echo "$body" >&2
                return 1
            fi
        else
            # B. NEW SUBMISSION FLOW ('preprint paper send')
            local existing_draft_id=""
            existing_draft_id=$(LC_ALL=C awk -F'\t' -v fn="$fname" -v t="$title" '
                $1 == "hexagon" && ($4 == t || $7 ~ ("\\|" fn "$") || $6 ~ (fn "$")) { print $2; exit }
            ' "$(__preprint_draft_store_file)" 2>/dev/null)

            if [[ -n "$existing_draft_id" ]]; then
                __log "Step 1/4: Overwriting existing Hexagon draft '$existing_draft_id' metadata (category: $subject)..." -t info -l preprint
                resp=$(curl -sS -w "\n%{http_code}" -X PATCH \
                    -H "Authorization: Bearer $token" \
                    -H "Content-Type: application/json" \
                    -d "$meta_json" \
                    "${base_url}/api/v1/submissions/${existing_draft_id}" 2>&1)
                http_code="${resp##*$'\n'}"
                body="${resp%$'\n'*}"
                if [[ "$http_code" == "200" ]]; then
                    draft_id="$existing_draft_id"
                else
                    __log "Draft '$existing_draft_id' is no longer editable on Hexagon (HTTP $http_code); creating a new draft..." -t warning -l preprint
                    __preprint_draft_rm "hexagon" "$existing_draft_id"
                fi
            fi

            if [[ -z "$draft_id" ]]; then
                local idem_key
                idem_key="omni-$(printf '%s-%s-%s' "$fname" "$title" "$subject" | cksum | awk '{print $1}')-$(date +%Y%m%d%H%M%S)"

                __log "Step 1/4: Creating Hexagon deposit draft (${base_url}/api/v1/submissions)..." -t info -l preprint
                resp=$(curl -sS -w "\n%{http_code}" -X POST \
                    -H "Authorization: Bearer $token" \
                    -H "Idempotency-Key: $idem_key" \
                    -H "Content-Type: application/json" \
                    -d "$meta_json" \
                    "${base_url}/api/v1/submissions" 2>&1)
                http_code="${resp##*$'\n'}"
                body="${resp%$'\n'*}"

                if [[ ! "$http_code" =~ ^20[01]$ ]]; then
                    [[ -n "$tmp_zip" ]] && rm -f "$tmp_zip"
                    __log "Failed to create Hexagon draft (HTTP $http_code)." -t error -l preprint
                    echo "$body" >&2
                    return 1
                fi

                draft_id=$(__preprint_parse_hexagon "extract_draft_id" "$base_url" <<< "$body")
                if [[ -z "$draft_id" ]]; then
                    [[ -n "$tmp_zip" ]] && rm -f "$tmp_zip"
                    __log "Could not parse draftId from Hexagon response:" -t error -l preprint
                    echo "$body" >&2
                    return 1
                fi
            fi
        fi

        local fsize upload_req upload_id
        fsize=$(wc -c < "$upload_target" | tr -d '[:space:]')
        upload_req="{\"kind\":\"${upload_kind}\",\"filename\":\"$(__preprint_json_escape "$fname")\",\"relativePath\":\"$(__preprint_json_escape "$fname")\",\"contentType\":\"${content_type}\",\"sizeBytes\":${fsize}}"

        __log "Step 2/4: Initializing file upload '$fname' ($fsize bytes) for draft '$draft_id'..." -t info -l preprint
        resp=$(curl -sS -w "\n%{http_code}" -X POST \
            -H "Authorization: Bearer $token" \
            -H "Content-Type: application/json" \
            -d "$upload_req" \
            "${base_url}/api/v1/submissions/${draft_id}/uploads" 2>&1)
        http_code="${resp##*$'\n'}"
        body="${resp%$'\n'*}"

        if [[ "$http_code" == "409" ]]; then
            local old_uid=$(__preprint_parse_hexagon "extract_upload_id" "$base_url" <<< "$body")
            if [[ -n "$old_uid" ]]; then
                curl -sS -X DELETE -H "Authorization: Bearer $token" "${base_url}/api/v1/submissions/${draft_id}/uploads/${old_uid}" >/dev/null 2>&1
                resp=$(curl -sS -w "\n%{http_code}" -X POST \
                    -H "Authorization: Bearer $token" \
                    -H "Content-Type: application/json" \
                    -d "$upload_req" \
                    "${base_url}/api/v1/submissions/${draft_id}/uploads" 2>&1)
                http_code="${resp##*$'\n'}"
                body="${resp%$'\n'*}"
            fi
        fi

        if [[ ! "$http_code" =~ ^20[01]$ ]]; then
            [[ -n "$tmp_zip" ]] && rm -f "$tmp_zip"
            __log "Failed to initialize upload on Hexagon draft '$draft_id' (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi

        upload_id=$(__preprint_parse_hexagon "extract_upload_id" "$base_url" <<< "$body")

        __log "Step 3/4: Uploading binary part 1 for upload '$upload_id'..." -t info -l preprint
        resp=$(curl -sS -w "\n%{http_code}" -X PUT \
            -H "Authorization: Bearer $token" \
            -H "Content-Type: application/octet-stream" \
            --data-binary @"$upload_target" \
            "${base_url}/api/v1/submissions/${draft_id}/uploads/${upload_id}/parts/1" 2>&1)
        http_code="${resp##*$'\n'}"
        body="${resp%$'\n'*}"
        [[ -n "$tmp_zip" ]] && rm -f "$tmp_zip"

        if [[ "$http_code" != "200" ]]; then
            __log "Failed uploading binary part 1 (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi

        __log "Step 4/4: Completing upload '$upload_id'..." -t info -l preprint
        resp=$(curl -sS -w "\n%{http_code}" -X POST \
            -H "Authorization: Bearer $token" \
            "${base_url}/api/v1/submissions/${draft_id}/uploads/${upload_id}/complete" 2>&1)
        http_code="${resp##*$'\n'}"
        body="${resp%$'\n'*}"

        if [[ "$http_code" != "200" ]]; then
            __log "Failed completing upload '$upload_id' (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi

        if [[ "$upload_kind" == "source-archive" ]]; then
            __log "Expanding source archive in Hexagon sandbox..." -t info -l preprint
            resp=$(curl -sS -w "\n%{http_code}" -X POST \
                -H "Authorization: Bearer $token" \
                "${base_url}/api/v1/submissions/${draft_id}/uploads/${upload_id}/expand" 2>&1)
            http_code="${resp##*$'\n'}"
            body="${resp%$'\n'*}"
            if [[ "$http_code" =~ ^20[01]$ ]]; then
                local main_tex
                main_tex=$(__preprint_parse_hexagon "extract_entry_tex" "$base_url" <<< "$body")
                if [[ -n "$main_tex" ]]; then
                    curl -sS -X POST \
                        -H "Authorization: Bearer $token" \
                        -H "Content-Type: application/json" \
                        -d "{\"relativePath\":\"$(__preprint_json_escape "$main_tex")\"}" \
                        "${base_url}/api/v1/submissions/${draft_id}/uploads/${upload_id}/entry-point" >/dev/null 2>&1
                fi
            fi
        fi

        PREPRINT_LAST_DRAFT_ID="$draft_id"
        __preprint_draft_save "hexagon" "$draft_id" "$pub_date" "$title" "${author//;/, }" "-" "${subject}|${fname}"
        __log "Hexagon Math draft staged! Draft ID: $draft_id" -t success -l preprint
        __log "Run 'preprint paper get $draft_id -d hexagon' to inspect, or 'preprint paper publish $draft_id -d hexagon' to commit & publish." -t info -l preprint
    }

    __preprint_provider_hexagon_send() {
        __preprint_hexagon_stage_deposit ""
    }

    __preprint_provider_hexagon_update() {
        local target_id="$1"
        __preprint_hexagon_stage_deposit "$target_id"
    }

    __preprint_provider_hexagon_publish() {
        local draft_id="${1#hexagon:}"
        [[ -z "$draft_id" ]] && { __log "Draft ID required: preprint paper publish <draftId> -d hexagon" -t error -l preprint; return 1; }

        local base_url token
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        if [[ -z "$token" ]]; then
            __log "Hexagon Math submission bearer token missing." -t error -l preprint
            return 1
        fi

        __log "Committing Hexagon Math draft '$draft_id' (${base_url}/api/v1/submissions/${draft_id}/commit)..." -t info -l preprint
        local resp http_code body
        resp=$(curl -sS -w "\n%{http_code}" -X POST \
            -H "Authorization: Bearer $token" \
            "${base_url}/api/v1/submissions/${draft_id}/commit" 2>&1)
        http_code="${resp##*$'\n'}"
        body="${resp%$'\n'*}"

        if [[ "$http_code" =~ ^20[012]$ ]]; then
            local perm_id
            perm_id=$(__preprint_parse_hexagon "extract_draft_id" "$base_url" <<< "$body")
            __log "Hexagon Math deposit committed for publication (HTTP $http_code)${perm_id:+ — Identifier: hexagon:$perm_id}!" -t success -l preprint
            echo "$body"
            return 0
        else
            __log "Failed to commit Hexagon Math draft '$draft_id' (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi
    }

    __preprint_provider_hexagon_rm() {
        local draft_id="${1#hexagon:}"
        [[ -z "$draft_id" ]] && { __log "Paper/Draft ID required to drop from Hexagon Math." -t error -l preprint; return 1; }

        local base_url token
        base_url="$(__preprint_hexagon_base_url)"
        token="${HEXAGON_TOKEN:-$(__preprint_get_conf hexagon token)}"
        if [[ -z "$token" ]]; then
            __log "Hexagon Math submission bearer token required." -t error -l preprint
            return 1
        fi

        local resp http_code body
        resp=$(curl -sS -w "\n%{http_code}" -X POST \
            -H "Authorization: Bearer $token" \
            -H "Content-Type: application/json" \
            -d '{"action":"cancel"}' \
            "${base_url}/api/v1/submissions/${draft_id}/lifecycle" 2>&1)
        http_code="${resp##*$'\n'}"
        body="${resp%$'\n'*}"

        if [[ "$http_code" =~ ^20[024]$ ]]; then
            __log "Cancelled and dropped '$draft_id' from Hexagon Math." -t success -l preprint
            return 0
        else
            __log "Failed to drop '$draft_id' on Hexagon Math (HTTP $http_code)." -t error -l preprint
            echo "$body" >&2
            return 1
        fi
    }
}
