#! /bin/bash

__scholar__() {
    __preprint_register_provider "scholar" \
        --aliases "gscholar,google-scholar,googlescholar" \
        --pagination "offset" \
        --requires-file "false" \
        --desc "Google Scholar (Author profile scraping, search, & local BibTeX profile sync)"

    __preprint_scholar_store() {
        local dir="${XDG_DATA_HOME:-$HOME/.local/share}/omni/preprint"
        mkdir -p "$dir"
        echo "$dir/scholar_profile.tsv"
    }

    __preprint_scholar_bib_export() {
        local store="$(__preprint_scholar_store)"
        local bib="${store%.tsv}.bib"
        [[ ! -f "$store" ]] && return 0
        LC_ALL=C awk -F'\t' '
            NF >= 4 {
                id = $1; date = $2; title = $3; authors = $4; journal = $5; doi = $6; url = $7
                yr = substr(date, 1, 4); if (yr !~ /^[0-9]{4}$/) yr = "2026"
                gsub(/;[ \t]*/, " and ", authors)
                printf "@article{%s,\n  title = {%s},\n  author = {%s},\n  year = {%s}", id, title, authors, yr
                if (journal != "" && journal != "-") printf ",\n  journal = {%s}", journal
                if (doi != "" && doi != "-") printf ",\n  doi = {%s}", doi
                if (url != "" && url != "-") printf ",\n  url = {%s}", url
                printf "\n}\n\n"
            }
        ' "$store" > "$bib"
    }

    __preprint_parse_scholar_html() {
        LC_ALL=C awk '
            function unesc_html(s) {
                gsub(/&lt;/, "<", s); gsub(/&gt;/, ">", s); gsub(/&amp;/, "\\&", s)
                gsub(/&quot;/, "\"", s); gsub(/&#39;|&apos;/, "\x27", s); gsub(/&nbsp;/, " ", s)
                gsub(/<[^>]+>/, "", s)
                gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s)
                gsub(/[ \t\r\n]+/, " ", s)
                return s
            }
            { raw = raw $0 "\n" }
            END {
                count = 0
                # 1. Author Profile Table Rows (tr class="gsc_a_tr")
                s = raw
                while (match(s, /<tr[^>]*class="gsc_a_tr"[^>]*>[\s\S]*?<\/tr>/)) {
                    row = substr(s, RSTART, RLENGTH)
                    s = substr(s, RSTART + RLENGTH)
                    cid = ""
                    if (match(row, /citation_for_view=[^"&]+/)) {
                        cid = substr(row, RSTART + 18, RLENGTH - 18)
                    }
                    title = ""
                    if (match(row, /class="gsc_a_at"[^>]*>[^<]+<\/a>/)) {
                        title = unesc_html(substr(row, RSTART, RLENGTH))
                    }
                    if (title == "") continue
                    authors = "Unknown Author"
                    if (match(row, /<div class="gs_gray">[^<]+<\/div>/)) {
                        authors = unesc_html(substr(row, RSTART, RLENGTH))
                    }
                    yr = "N/A"
                    if (match(row, /class="gsc_a_h[^"]*"[^>]*>[0-9]{4}<\/span>/)) {
                        yr = unesc_html(substr(row, RSTART, RLENGTH))
                    }
                    if (cid == "") {
                        cid = "gs_" (++count)
                    } else {
                        count++
                    }
                    printf "[%s] (%s) %s   %s\n", cid, yr, title, authors
                }
                if (count > 0) exit 0

                # 2. Search Results Blocks (div class="gs_r gs_or gs_scl")
                s = raw
                while (match(s, /<div[^>]*class="gs_ri"[^>]*>[\s\S]*?<\/div>[ \t\r\n]*<\/div>/)) {
                    blk = substr(s, RSTART, RLENGTH)
                    s = substr(s, RSTART + RLENGTH)
                    id = ""
                    if (match(blk, /data-cid="[^"]+"/)) {
                        id = substr(blk, RSTART + 10, RLENGTH - 11)
                    }
                    title = ""
                    if (match(blk, /<h3[^>]*class="gs_rt"[^>]*>[\s\S]*?<\/h3>/)) {
                        title = unesc_html(substr(blk, RSTART, RLENGTH))
                        sub(/^\[(PDF|HTML|BOOK|CITATION)\][ \t]*/, "", title)
                    }
                    if (title == "") continue
                    meta = ""
                    if (match(blk, /<div[^>]*class="gs_a"[^>]*>[\s\S]*?<\/div>/)) {
                        meta = unesc_html(substr(blk, RSTART, RLENGTH))
                    }
                    yr = "N/A"
                    if (match(meta, /(19|20)[0-9]{2}/)) {
                        yr = substr(meta, RSTART, 4)
                    }
                    authors = meta
                    sub(/[ \t]*-[ \t]*.*$/, "", authors)
                    if (authors == "") authors = "Unknown Author"
                    count++
                    if (id == "") id = "scholar_" count
                    printf "[%s] (%s) %s   %s\n", id, yr, title, authors
                }
                if (count == 0) exit 1
            }
        '
    }

    __preprint_provider_scholar_list() {
        local max="${1:-0}" sort_by="${2:-time}" reverse="${3:-0}"
        local limit=$(( max > 0 ? max : 100 ))
        local profile token store
        profile="${SCHOLAR_PROFILE:-$(__preprint_get_conf scholar profile)}"
        [[ -z "$profile" ]] && profile="$(__preprint_get_conf scholar user)"
        token="${SCHOLAR_TOKEN:-$(__preprint_get_conf scholar token)}"
        store="$(__preprint_scholar_store)"

        local out=""
        if [[ -f "$store" ]]; then
            local local_entries
            local_entries=$(LC_ALL=C awk -F'\t' 'NF >= 4 { printf "[%s] (%s) %s   %s\n", $1, $2, $3, $4 }' "$store")
            [[ -n "$local_entries" ]] && out="$local_entries"
        fi

        if [[ -n "$profile" ]]; then
            local html remote_entries=""
            html=$(curl -fsSL -A "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0" \
                "https://scholar.google.com/citations?user=$(__preprint_urlencode "$profile")&hl=en&cstart=0&pagesize=${limit}" 2>/dev/null)
            if [[ -n "$html" ]]; then
                remote_entries=$(__preprint_parse_scholar_html <<< "$html" 2>/dev/null)
            fi
            if [[ -z "$remote_entries" && -n "$token" ]]; then
                local serp_json
                serp_json=$(curl -fsSL "https://serpapi.com/search.json?engine=google_scholar_author&author_id=$(__preprint_urlencode "$profile")&api_key=$(__preprint_urlencode "$token")" 2>/dev/null)
                remote_entries=$(LC_ALL=C awk '
                    function get_str(c, k,    p, s) {
                        p = "\"" k "\"[ \t]*:[ \t]*\""
                        if (match(c, p "(\\\\.|[^\"\\\\])*\"")) {
                            s = substr(c, RSTART, RLENGTH); sub("^" p, "", s); sub(/"$/, "", s); return s
                        }
                        return ""
                    }
                    { raw = raw $0 "\n" }
                    END {
                        n = split(raw, arr, /"citation_id"[ \t]*:/)
                        for (i = 2; i <= n; i++) {
                            c = "\"citation_id\":" arr[i]
                            cid = get_str(c, "citation_id")
                            t = get_str(c, "title")
                            a = get_str(c, "authors")
                            y = get_str(c, "year")
                            if (t != "") printf "[%s] (%s) %s   %s\n", cid, (y ? y : "N/A"), t, (a ? a : "Unknown")
                        }
                    }
                ' <<< "$serp_json")
            fi
            if [[ -n "$remote_entries" ]]; then
                out="${out:+$out$'\n'}${remote_entries}"
            fi
        fi

        if [[ -z "$out" ]]; then
            if [[ -z "$profile" ]]; then
                __log "Set your Google Scholar User ID (from citations?user=<ID>) or add local entries via 'preprint profile add scholar':
  preprint database set -d scholar --profile <scholar_user_id>" -t error -l preprint
                return 1
            fi
            echo "No entries found in Google Scholar profile."
            return 0
        fi

        if (( max > 0 )); then
            head -n "$max" <<< "$out"
        else
            echo "$out"
        fi
    }

    __preprint_provider_scholar_get() {
        local id="$1"
        local store="$(__preprint_scholar_store)"
        if [[ -f "$store" ]]; then
            local found
            found=$(LC_ALL=C awk -F'\t' -v target="$id" '
                $1 == target {
                    printf "ID:        %s\nTitle:     %s\nPublished: %s\nAuthors:   %s\nVenue:     %s\nDOI:       %s\nURL:       %s\nAbstract:\n  %s\n", $1, $3, $2, $4, $5, $6, $7, $8
                    exit 0
                }
            ' "$store")
            if [[ -n "$found" ]]; then
                echo "$found"
                return 0
            fi
        fi

        if [[ "$id" == *:* ]]; then
            local user_id="${id%%:*}"
            local view_url="https://scholar.google.com/citations?view_op=view_citation&hl=en&user=${user_id}&citation_for_view=${id}"
            local html
            html=$(curl -fsSL -A "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0" "$view_url" 2>/dev/null)
            if [[ -n "$html" ]]; then
                LC_ALL=C awk -v id="$id" -v url="$view_url" '
                    function unesc(s) { gsub(/<[^>]+>/, "", s); gsub(/&amp;/, "\\&", s); gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s); return s }
                    { raw = raw $0 "\n" }
                    END {
                        title = "Untitled"
                        if (match(raw, /id="gsc_oci_title"[^>]*>[\s\S]*?<\/div>/)) title = unesc(substr(raw, RSTART, RLENGTH))
                        pdf = "N/A"
                        if (match(raw, /class="gsc_oci_title_ggi"[\s\S]*?href="https?:\/\/[^"]+"/)) {
                            s = substr(raw, RSTART, RLENGTH)
                            if (match(s, /href="https?:\/\/[^"]+"/)) pdf = substr(s, RSTART + 6, RLENGTH - 7)
                        }
                        desc = "N/A"
                        if (match(raw, /id="gsc_oci_descr"[^>]*>[\s\S]*?<\/div>/)) desc = unesc(substr(raw, RSTART, RLENGTH))
                        printf "ID:        %s\nTitle:     %s\nURL:       %s\nPDF:       %s\nAbstract:\n  %s\n", id, title, url, pdf, desc
                    }
                ' <<< "$html"
                return 0
            fi
        fi
        echo "Google Scholar Entry ID: $id (View at https://scholar.google.com/scholar?q=$(__preprint_urlencode "$id"))"
    }

    __preprint_provider_scholar_search() {
        local term="$1" limit="${2:-20}" start="${3:-0}" sort_by="${4:-time}" reverse="${5:-0}"
        local enc_term=$(__preprint_urlencode "$term")
        local token="${SCHOLAR_TOKEN:-$(__preprint_get_conf scholar token)}"
        local html out=""

        if [[ -n "$token" ]]; then
            local serp_json
            serp_json=$(curl -fsSL "https://serpapi.com/search.json?engine=google_scholar&q=${enc_term}&start=${start}&num=${limit}&api_key=$(__preprint_urlencode "$token")" 2>/dev/null)
            out=$(LC_ALL=C awk '
                function get_str(c, k,    p, s) {
                    p = "\"" k "\"[ \t]*:[ \t]*\""
                    if (match(c, p "(\\\\.|[^\"\\\\])*\"")) {
                        s = substr(c, RSTART, RLENGTH); sub("^" p, "", s); sub(/"$/, "", s); return s
                    }
                    return ""
                }
                { raw = raw $0 "\n" }
                END {
                    n = split(raw, arr, /"result_id"[ \t]*:/)
                    for (i = 2; i <= n; i++) {
                        c = "\"result_id\":" arr[i]
                        rid = get_str(c, "result_id")
                        t = get_str(c, "title")
                        s = get_str(c, "summary")
                        yr = "N/A"
                        if (match(s, /(19|20)[0-9]{2}/)) yr = substr(s, RSTART, 4)
                        if (t != "") printf "[%s] (%s) %s   %s\n", rid, yr, t, (s ? s : "Google Scholar")
                    }
                }
            ' <<< "$serp_json")
        fi

        if [[ -z "$out" ]]; then
            html=$(curl -fsSL -A "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0" \
                "https://scholar.google.com/scholar?q=${enc_term}&hl=en&start=${start}&num=${limit}" 2>/dev/null)
            [[ -n "$html" ]] && out=$(__preprint_parse_scholar_html <<< "$html" 2>/dev/null)
        fi

        if [[ -z "$out" ]]; then
            # Fallback to OpenAlex when Google Scholar blocks headless curl requests
            local page=$(( (start / (limit > 0 ? limit : 20)) + 1 ))
            out=$(__preprint_provider_openalex_search "$term" "$limit" "$page" "$sort_by" "$reverse")
        fi

        if [[ -n "$out" && "$out" != "No "* ]]; then
            echo "$out"
        else
            echo "No entries found in Google Scholar."
        fi
    }   

    __preprint_provider_scholar_download() {
        local id="$1" out_path="${2:-}"
        local store="$(__preprint_scholar_store)"
        if [[ -f "$store" ]]; then
            local doi url
            read -r doi url < <(LC_ALL=C awk -F'\t' -v target="$id" '$1 == target { print $6, $7; exit }' "$store")
            if [[ -n "$url" && "$url" != "-" && "$url" == *.pdf* ]]; then
                __preprint_save_pdf_stream "$url" "scholar_${id}.pdf" "$out_path"
                return $?
            elif [[ -n "$doi" && "$doi" != "-" ]]; then
                __preprint_resolve_doi_pdf "$doi" "$out_path" "scholar_${id}.pdf"
                return $?
            fi
        fi

        if [[ "$id" == *:* ]]; then
            local user_id="${id%%:*}"
            local view_url="https://scholar.google.com/citations?view_op=view_citation&hl=en&user=${user_id}&citation_for_view=${id}"
            local html pdf_url
            html=$(curl -fsSL -A "Mozilla/5.0 (X11; Linux x86_64; rv:128.0) Gecko/20100101 Firefox/128.0" "$view_url" 2>/dev/null)
            pdf_url=$(LC_ALL=C awk '
                match($0, /class="gsc_oci_title_ggi"[\s\S]*?href="https?:\/\/[^"]+"/) {
                    s = substr($0, RSTART, RLENGTH)
                    if (match(s, /href="https?:\/\/[^"]+"/)) {
                        print substr(s, RSTART + 6, RLENGTH - 7); exit
                    }
                }
            ' <<< "$html")
            if [[ -n "$pdf_url" ]]; then
                __preprint_save_pdf_stream "$pdf_url" "scholar_${id//:/_}.pdf" "$out_path"
                return $?
            fi
        fi
        __log "Could not resolve direct PDF for Google Scholar entry '$id'." -t error -l preprint
        return 1
    }

    __preprint_provider_scholar_send() {
        local file="$PREPRINT_SEND_FILE" title="$PREPRINT_SEND_TITLE" author="$PREPRINT_SEND_AUTHOR"
        local abstract="$PREPRINT_SEND_ABSTRACT" pub_date="$PREPRINT_SEND_DATE"
        local journal="${PREPRINT_SEND_JOURNAL:--}" doi="${PREPRINT_SEND_DOI:--}" url="${PREPRINT_SEND_URL:--}"

        [[ -z "$title" && -n "$file" ]] && title="$(basename "${file%.*}")"
        if [[ -z "$title" ]]; then
            __log "Google Scholar profile entry requires a title (-t/--title)." -t error -l preprint
            return 1
        fi
        [[ -z "$author" ]] && author="${USER:-Anonymous}"
        [[ -z "$pub_date" ]] && printf -v pub_date "%(%Y-%m-%d)T" -1
        [[ -z "$abstract" ]] && abstract="-"

        local store="$(__preprint_scholar_store)"
        local entry_id="gs_$(date +%s)"
        [[ -n "${PREPRINT_SEND_EXT_IDS[arxiv]:-}" ]] && entry_id="arxiv:${PREPRINT_SEND_EXT_IDS[arxiv]}"
        [[ "$doi" != "-" ]] && entry_id="doi:${doi//\//_}"

        # Clean tabs/newlines
        title="${title//$'\t'/ }"; title="${title//$'\n'/ }"
        author="${author//$'\t'/ }"; abstract="${abstract//$'\t'/ }"; abstract="${abstract//$'\n'/ }"

        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
            "$entry_id" "$pub_date" "$title" "$author" "$journal" "$doi" "$url" "$abstract" >> "$store"
        __preprint_scholar_bib_export

        __log "Added '$title' [$entry_id] to Google Scholar profile store ($store)." -t success -l preprint
        __log "Updated BibTeX export for Google Scholar import at: ${store%.tsv}.bib" -t info -l preprint
    }

    __preprint_provider_scholar_rm() {
        local id="$1"
        [[ -z "$id" ]] && { __log "Entry ID required to remove from Google Scholar profile." -t error -l preprint; return 1; }
        local store="$(__preprint_scholar_store)"
        if [[ ! -f "$store" ]]; then
            __log "No local Google Scholar entries found in $store." -t error -l preprint
            return 1
        fi
        local tmp="${store}.tmp"
        local removed=0
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "${line%%$'\t'*}" == "$id" ]]; then
                removed=1
            else
                printf "%s\n" "$line" >> "$tmp"
            fi
        done < "$store"
        mv "$tmp" "$store"
        __preprint_scholar_bib_export

        if (( removed == 1 )); then
            __log "Removed '$id' from Google Scholar profile store and updated ${store%.tsv}.bib." -t success -l preprint
        else
            __log "Entry '$id' not found in local Google Scholar store (remote scraped entries must be deleted in Google Scholar UI)." -t warning -l preprint
            return 1
        fi
    }
}
